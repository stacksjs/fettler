<script client>
import { fuzzyFilter } from '../functions/fuzzy'
import { renderTinkerValue } from '../functions/tinker-value'

const code = state('const numbers = [1, 2, 3]\nnumbers.map(n => n * 2)\n')
const connection = state(null)
const projectPath = state('')
const connecting = state(false)
const running = state(false)
const notice = state('')
const output = state('')
const result = state('')
const failure = state('')
const duration = state('')
const queries = state([])

const widgets = state([])
const recent = state([])
const snippets = state([])
const historyEntries = state([])
const paletteOpen = state(false)
const paletteQuery = state('')
const paletteActive = state(0)
const paletteInput = useRef('paletteInput')
const diagnostics = state([])
const editorRef = ref()
let checkTimer = 0
let checkSerial = 0

const view = state('result')
const logLines = state([])
const logLevel = state('all')
const logQuery = state('')
const logFollowing = state(false)
const logNote = state('')
let logAbort = null

const LOG_RANK = { debug: 0, info: 1, success: 1, warning: 2, error: 3 }
const shownLogs = derived(() => {
  const floor = logLevel() === 'all' ? -1 : LOG_RANK[logLevel()]
  const query = logQuery().trim().toLowerCase()
  return logLines().filter(line => LOG_RANK[line.level] >= floor && (!query || line.raw.toLowerCase().includes(query)))
})

function stopLogs() {
  if (logAbort) logAbort.abort()
  logAbort = null
  logFollowing.set(false)
}

// Lines are read from a response that stays open: each one is shown as the target writes it.
async function followLogs() {
  stopLogs()
  logLines.set([])
  logNote.set('')
  if (!connected()) return
  logAbort = new AbortController()
  logFollowing.set(true)
  try {
    const response = await fetch('/__fettler/logs', { signal: logAbort.signal })
    if (!response.ok || !response.body) {
      const body = await response.json().catch(() => ({}))
      logNote.set(body.error || 'The log could not be followed.')
      return
    }
    const reader = response.body.getReader()
    const decoder = new TextDecoder()
    let pending = ''
    for (;;) {
      const { value, done } = await reader.read()
      if (done) break
      pending += decoder.decode(value, { stream: true })
      const parts = pending.split('\n')
      pending = parts.pop() || ''
      const fresh = parts.filter(Boolean).map(part => JSON.parse(part))
      if (fresh.length) logLines.set([...logLines(), ...fresh].slice(-2000))
    }
  }
  catch (cause) {
    if (!(cause && cause.name === 'AbortError')) logNote.set(cause instanceof Error ? cause.message : 'The log stopped.')
  }
  finally {
    logFollowing.set(false)
  }
}

function showView(name) {
  view.set(name)
  if (name === 'logs' && !logFollowing()) void followLogs()
  if (name === 'info') void loadPanels()
  if (name !== 'logs') stopLogs()
}

function logClass(level) {
  if (level === 'error') return 'text-red-700 dark:text-red-300'
  if (level === 'warning') return 'text-amber-700 dark:text-amber-300'
  if (level === 'debug') return 'text-neutral-400'
  return 'text-neutral-700 dark:text-neutral-200'
}

const ai = state({ enabled: false, provider: 'anthropic', model: '', host: '', automatic: false, hasKey: false })
const aiOpen = state(false)
const aiKey = state('')
const aiSaving = state(false)
const chat = state([])
const question = state('')
const asking = state(false)
const chatNote = state('')
const ghost = state('')
let ghostTimer = 0
let ghostAbort = null
let caret = { line: 0, column: 0 }

async function loadAi() {
  const response = await fetch('/__fettler/ai')
  if (response.ok) ai.set(await response.json())
}

function setAi(name, value) {
  ai.set({ ...ai(), [name]: value })
}

async function saveAi() {
  aiSaving.set(true)
  try {
    const { hasKey: _hasKey, ...settings } = ai()
    const response = await fetch('/__fettler/ai', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ ...settings, ...(aiKey().trim() ? { key: aiKey().trim() } : {}) }),
    })
    if (response.ok) ai.set(await response.json())
    aiKey.set('')
    aiOpen.set(false)
  }
  finally {
    aiSaving.set(false)
  }
}

async function forgetKey() {
  const response = await fetch('/__fettler/ai', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ key: null }) })
  if (response.ok) ai.set(await response.json())
}

function offsetOf(text, line, column) {
  const lines = text.split('\n')
  let offset = 0
  for (let index = 0; index < line && index < lines.length; index++) offset += lines[index].length + 1
  return offset + column
}

// A suggestion at the cursor. Asked for with Alt+Backslash, or after a pause when that is turned on.
async function suggest() {
  if (!ai().enabled || !ai().hasKey) return
  if (ghostAbort) ghostAbort.abort()
  ghostAbort = new AbortController()
  const text = code()
  const at = offsetOf(text, caret.line, caret.column)
  try {
    const response = await fetch('/__fettler/ai/suggest', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ before: text.slice(0, at), after: text.slice(at) }),
      signal: ghostAbort.signal,
    })
    const body = await response.json()
    ghost.set(response.ok ? (body.suggestion || '') : '')
    if (!response.ok && body.error) notice.set(body.error)
  }
  catch (cause) {
    if (!(cause && cause.name === 'AbortError')) ghost.set('')
  }
}

function scheduleSuggest() {
  clearTimeout(ghostTimer)
  ghost.set('')
  if (ai().enabled && ai().automatic && ai().hasKey) ghostTimer = setTimeout(suggest, 700)
}

function onSelection(detail) {
  if (detail) caret = { line: detail.line, column: detail.column }
}

async function ask() {
  const text = question().trim()
  if (!text || asking()) return
  const messages = [...chat(), { role: 'user', content: text }]
  chat.set(messages)
  question.set('')
  asking.set(true)
  chatNote.set('')
  try {
    const response = await fetch('/__fettler/ai/ask', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ messages: messages.map(message => ({ role: message.role, content: message.content })), code: code() }),
    })
    const body = await response.json()
    if (!response.ok) {
      chatNote.set(body.error || 'The assistant could not answer.')
      if (body.notReady) aiOpen.set(true)
      return
    }
    chat.set([...messages, { role: 'assistant', content: body.answer, code: body.code }])
  }
  catch (cause) {
    chatNote.set(cause instanceof Error ? cause.message : 'The assistant could not answer.')
  }
  finally {
    asking.set(false)
  }
}

function useCode(source) {
  code.set(source)
  scheduleCheck()
  showView('result')
}

const panels = state([])
const panelsNote = state('')

async function loadPanels() {
  panels.set([])
  panelsNote.set('')
  if (!connected()) return
  const response = await fetch('/__fettler/panels')
  const body = await response.json().catch(() => ({}))
  panels.set(body.panels || [])
  if (body.error) panelsNote.set(body.error)
}

const mcpOpen = state(false)
const mcp = state({ enabled: false, address: '', token: '' })

async function loadMcp() {
  const response = await fetch('/__fettler/mcp-settings')
  if (response.ok) mcp.set({ token: '', ...(await response.json()) })
}

async function setMcp(enabled) {
  const response = await fetch('/__fettler/mcp-settings', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ enabled }) })
  if (response.ok) mcp.set({ token: '', ...(await response.json()) })
}

// What an MCP client is given: the address and the bearer token, in the shape most of them take.
const mcpConfig = derived(() => JSON.stringify({ mcpServers: { fettler: { type: 'http', url: mcp().address, headers: { Authorization: `Bearer ${mcp().token || 'the token shown when you turned this on'}` } } } }, null, 2))

const connectOpen = state(false)
const connectKind = state('ssh')
const form = state({ host: '', user: '', port: '', identityFile: '', jump: '', directory: '', envFile: '.env', container: '', pod: '', namespace: '', context: '' })
const found = state([])
const finding = state(false)
const confirming = state('')

const isProduction = derived(() => /prod|live/i.test((connection() && connection().environment) || ''))
const environmentLabel = derived(() => (connection() && connection().environment) || '')
const whereLabel = derived(() => (connection() && connection().where) || '')
const connected = derived(() => connection() !== null)
const targetLabel = derived(() => connection() ? connection().label : 'Not connected')

async function loadState() {
  const response = await fetch('/__fettler/state')
  if (!response.ok) return
  const body = await response.json()
  connection.set(body.connection)
  recent.set(body.recent || [])
}

function firstLine(text) {
  const line = (text || '').split('\n').find(part => part.trim()) || ''
  return line.length > 90 ? `${line.slice(0, 90)}...` : line
}

// Everything the palette can do, as one list: actions, then projects, snippets and what was run.
const paletteItems = derived(() => {
  const items = [
    { kind: 'action', id: 'run', title: 'Run', hint: 'Cmd+Enter' },
    { kind: 'action', id: 'sandbox', title: 'Open the sandbox', hint: '' },
    { kind: 'action', id: 'remote', title: 'Connect to a server, container or pod', hint: '' },
    { kind: 'action', id: 'assistant', title: 'Ask the assistant', hint: '' },
    { kind: 'action', id: 'mcp', title: 'Let AI tools use Fettler (MCP)', hint: mcp().enabled ? 'on' : 'off' },
    { kind: 'action', id: 'ai-settings', title: 'AI settings', hint: ai().enabled ? ai().provider : 'off' },
    { kind: 'action', id: 'suggest', title: 'Suggest at the cursor', hint: 'Alt+Backslash' },
    { kind: 'action', id: 'save', title: 'Save as snippet', hint: firstLine(code()) },
    { kind: 'action', id: 'clear-history', title: 'Clear history for this connection', hint: '' },
  ]
  for (const item of recent()) {
    if (item.kind === 'local') items.push({ kind: 'project', id: item.key, title: `Open ${item.label}`, hint: item.path, path: item.path })
    else if (item.spec && item.kind !== 'sandbox') items.push({ kind: item.kind, id: item.key, title: `Open ${item.label}`, hint: item.where || '', spec: item.spec })
  }
  for (const item of snippets()) items.push({ kind: 'snippet', id: `s${item.id}`, title: item.title, hint: firstLine(item.code), code: item.code })
  for (const item of historyEntries()) items.push({ kind: 'history', id: `h${item.id}`, title: firstLine(item.code), hint: item.ok ? '' : 'failed', code: item.code })
  return fuzzyFilter(paletteQuery(), items, item => `${item.title} ${item.hint || ''}`).slice(0, 80)
})

async function openPalette() {
  paletteQuery.set('')
  paletteActive.set(0)
  paletteOpen.set(true)
  await nextTick()
  if (paletteInput.value) paletteInput.value.focus()
  const [snippetsResponse, historyResponse] = await Promise.all([fetch('/__fettler/snippets'), fetch('/__fettler/history')])
  if (snippetsResponse.ok) snippets.set((await snippetsResponse.json()).snippets || [])
  if (historyResponse.ok) historyEntries.set((await historyResponse.json()).entries || [])
  await loadState()
}

function closePalette() {
  paletteOpen.set(false)
  const editor = editorRef.value && editorRef.value.__stx_exposed
  if (editor) editor.focus()
}

async function choose(item) {
  if (!item) return
  closePalette()
  if (item.kind === 'snippet' || item.kind === 'history') {
    code.set(item.code)
    scheduleCheck()
  }
  else if (item.kind === 'project') {
    projectPath.set(item.path)
    await connect({ kind: 'local', path: item.path })
  }
  else if (item.spec) {
    await connect(item.spec)
  }
  else if (item.id === 'remote') {
    connectOpen.set(true)
  }
  else if (item.id === 'assistant') {
    showView('assistant')
  }
  else if (item.id === 'ai-settings') {
    aiOpen.set(true)
  }
  else if (item.id === 'mcp') {
    await loadMcp()
    mcpOpen.set(true)
  }
  else if (item.id === 'suggest') {
    await suggest()
  }
  else if (item.id === 'run') {
    runAll()
  }
  else if (item.id === 'sandbox') {
    await connect({ kind: 'sandbox' })
  }
  else if (item.id === 'save') {
    await fetch('/__fettler/snippets', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ title: firstLine(code()) || 'Untitled', code: code(), scoped: connection() && connection().kind === 'local' }),
    })
    notice.set('Saved as a snippet.')
  }
  else if (item.id === 'clear-history') {
    await fetch('/__fettler/history', { method: 'DELETE' })
    notice.set('History cleared.')
  }
}

function paletteKey(event) {
  const count = paletteItems().length
  if (event.key === 'ArrowDown') { event.preventDefault(); paletteActive.set(count ? (paletteActive() + 1) % count : 0) }
  else if (event.key === 'ArrowUp') { event.preventDefault(); paletteActive.set(count ? (paletteActive() - 1 + count) % count : 0) }
  else if (event.key === 'Enter') { event.preventDefault(); void choose(paletteItems()[paletteActive()]) }
  else if (event.key === 'Escape') { event.preventDefault(); closePalette() }
}

function appKey(event) {
  if (event.altKey && event.code === 'Backslash') {
    event.preventDefault()
    void suggest()
    return
  }
  if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
    event.preventDefault()
    if (paletteOpen()) closePalette()
    else void openPalette()
  }
}

async function connect(target) {
  connecting.set(true)
  notice.set('')
  try {
    const response = await fetch('/__fettler/connect', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(target),
    })
    const body = await response.json()
    if (!response.ok) throw new Error(body.error || 'Could not connect.')
    connection.set(body.connection)
    scheduleCheck()
    const warnings = body.session?.warnings || []
    notice.set(warnings.length ? warnings.join(' ') : '')
  }
  catch (cause) {
    notice.set(cause instanceof Error ? cause.message : 'Could not connect.')
  }
  finally {
    connecting.set(false)
  }
}

function setField(name, value) {
  form.set({ ...form(), [name]: value })
}

function sshPart() {
  const f = form()
  if (!f.host.trim()) return undefined
  return {
    host: f.host.trim(),
    ...(f.user.trim() ? { user: f.user.trim() } : {}),
    ...(f.port.trim() ? { port: Number(f.port) } : {}),
    ...(f.identityFile.trim() ? { identityFile: f.identityFile.trim() } : {}),
    ...(f.jump.trim() ? { jump: f.jump.trim() } : {}),
  }
}

function remoteTarget() {
  const f = form()
  const project = { directory: f.directory.trim(), ...(f.envFile.trim() ? { envFile: f.envFile.trim() } : {}) }
  const pod = f.pod.trim()
    ? { pod: f.pod.trim(), ...(f.namespace.trim() ? { namespace: f.namespace.trim() } : {}), ...(f.context.trim() ? { context: f.context.trim() } : {}), ...(f.container.trim() ? { container: f.container.trim() } : {}) }
    : undefined
  if (connectKind() === 'ssh') {
    return { kind: 'ssh', ...sshPart(), ...project, ...(pod ? { pod } : f.container.trim() ? { container: f.container.trim() } : {}) }
  }
  if (connectKind() === 'docker') return { kind: 'docker', container: f.container.trim(), ...project }
  return { kind: 'kube', ...pod, ...project }
}

// List what is running on the target, so a container or a pod is picked, not typed.
async function discover(what) {
  finding.set(true)
  found.set([])
  notice.set('')
  try {
    const f = form()
    const response = await fetch('/__fettler/discover', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ what, ssh: connectKind() === 'ssh' ? sshPart() : undefined, context: f.context.trim() || undefined, namespace: f.namespace.trim() || undefined }),
    })
    const body = await response.json()
    if (!response.ok) throw new Error(body.error || 'Nothing could be listed.')
    if (what === 'containers') found.set(body.containers.map(item => ({ field: 'container', value: item.name, hint: `${item.image} (${item.status})` })))
    else if (what === 'pods') found.set(body.pods.map(item => ({ field: 'pod', value: item.name, hint: item.phase })))
    else if (what === 'contexts') found.set(body.contexts.map(item => ({ field: 'context', value: item, hint: '' })))
    else if (what === 'namespaces') found.set(body.namespaces.map(item => ({ field: 'namespace', value: item, hint: '' })))
  }
  catch (cause) {
    notice.set(cause instanceof Error ? cause.message : 'Nothing could be listed.')
  }
  finally {
    finding.set(false)
  }
}

async function pick(item) {
  setField(item.field, item.value)
  found.set([])
  if (item.field !== 'container' || form().directory.trim()) return
  const response = await fetch('/__fettler/discover', {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ what: 'workdir', container: item.value, ssh: connectKind() === 'ssh' ? sshPart() : undefined }),
  })
  const body = await response.json().catch(() => ({}))
  if (body.workdir) setField('directory', body.workdir)
}

async function connectRemote() {
  await connect(remoteTarget())
  if (connected() && connection().kind !== 'sandbox' && connection().kind !== 'local') connectOpen.set(false)
}

function connectProject() {
  const path = projectPath().trim()
  if (path) void connect({ kind: 'local', path })
}

function take(frame) {
  if (frame.type === 'stdout' || frame.type === 'stderr' || frame.type === 'stray') output.set(output() + frame.text)
  else if (frame.type === 'dump') output.set(`${output()}${renderTinkerValue(frame.value)}\n`)
  else if (frame.type === 'query') queries.set([...queries(), frame])
  else if (frame.type === 'probe') {
    const text = frame.kind === 'time' ? `${frame.ms} ms` : renderTinkerValue(frame.value).replace(/\s*\n\s*/g, ' ')
    widgets.set([...widgets(), { line: frame.line, text: text.length > 120 ? `${text.slice(0, 120)}...` : text, kind: frame.kind === 'time' ? 'info' : 'result' }])
  }
  else if (frame.type === 'result') { result.set(renderTinkerValue(frame.value)); duration.set(`${frame.durationMs} ms`) }
  else if (frame.type === 'error') { failure.set(renderTinkerValue(frame.error)); duration.set(`${frame.durationMs} ms`) }
  else if (frame.type === 'agent-error') failure.set(frame.message)
}

async function run(source) {
  if (running() || !connected()) return
  running.set(true)
  output.set('')
  result.set('')
  failure.set('')
  duration.set('')
  queries.set([])
  widgets.set([])
  try {
    const response = await fetch('/__fettler/run', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ code: source }),
    })
    if (!response.ok || !response.body) {
      const body = await response.json().catch(() => ({}))
      throw new Error(body.error || 'The run could not start.')
    }
    const reader = response.body.getReader()
    const decoder = new TextDecoder()
    let pending = ''
    for (;;) {
      const { value, done } = await reader.read()
      if (done) break
      pending += decoder.decode(value, { stream: true })
      const lines = pending.split('\n')
      pending = lines.pop() || ''
      for (const line of lines) if (line) take(JSON.parse(line))
    }
  }
  catch (cause) {
    failure.set(cause instanceof Error ? cause.message : 'The run failed.')
  }
  finally {
    running.set(false)
  }
}

async function language(op, text, line, column) {
  const response = await fetch('/__fettler/language', {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ op, text, line, column }),
  })
  return response.ok ? response.json() : {}
}

// Completions come from the project's own TypeScript server, so a model's
// columns and an action's parameters are what is offered.
async function complete(detail) {
  if (!connected() || !detail) return
  const body = await language('complete', code(), detail.line, detail.column)
  // A ref on a component is its element; what the component exposes hangs off it.
  const editor = editorRef.value && editorRef.value.__stx_exposed
  if (!editor || !body.items) return
  const query = (detail.query || '').toLowerCase()
  const items = body.items
    .filter(item => !query || item.label.toLowerCase().startsWith(query))
    .slice(0, 60)
    .map(item => ({ label: item.label, kind: item.kind, detail: item.detail, insert: item.insert }))
  if (items.length) editor.showCompletions(items, { from: detail.from })
}

function scheduleCheck() {
  clearTimeout(checkTimer)
  if (!connected()) return
  checkTimer = setTimeout(async () => {
    const serial = ++checkSerial
    const body = await language('diagnostics', code(), 0, 0)
    if (serial === checkSerial) diagnostics.set(body.diagnostics || [])
  }, 350)
}

// On production a run is asked for twice: once to say what it will touch, once to do it.
function guarded(source) {
  if (!isProduction() || confirming() === source) {
    confirming.set('')
    void run(source)
    return
  }
  confirming.set(source)
}

function runAll(detail) {
  guarded(detail && typeof detail.value === 'string' ? detail.value : code())
}

function runSelection(detail) {
  if (detail && detail.text) guarded(detail.text)
}

void loadState()
void loadAi()
void loadMcp()
</script>

@nolayout
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Fettler</title>
  </head>
  <body class="h-screen overflow-hidden antialiased text-neutral-900 dark:text-neutral-100 bg-neutral-50 dark:bg-neutral-950">
    <div class="flex flex-col h-screen" data-fettler-app @keydown="appKey($event)">
      <header class="flex gap-3 items-center px-3 h-11 border-b border-neutral-200 dark:border-neutral-800 shrink-0">
        <span class="font-medium text-sm" data-fettler-target>{{ targetLabel() }}</span>
        @if(whereLabel())
          <span class="font-mono text-[11px] text-neutral-500" data-fettler-where>{{ whereLabel() }}</span>
        @endif
        @if(environmentLabel())
          <span :class="isProduction() ? 'px-1.5 py-0.5 font-medium text-[10px] text-white uppercase tracking-wide bg-red-600 rounded' : 'px-1.5 py-0.5 font-medium text-[10px] text-neutral-600 uppercase tracking-wide dark:text-neutral-300 bg-neutral-200 dark:bg-neutral-800 rounded'" data-fettler-environment>{{ environmentLabel() }}</span>
        @endif
        <input
          type="text"
          :value="projectPath()"
          @input="projectPath.set($event.target.value)"
          @keydown.enter="connectProject()"
          placeholder="Path to a Stacks project"
          aria-label="Project path"
          class="flex-1 min-w-0 px-2 h-7 font-mono text-xs bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-md focus:outline-none focus:border-neutral-400"
          data-fettler-path
        >
        <button type="button" class="px-2.5 h-7 text-xs bg-white dark:bg-neutral-900 hover:bg-neutral-100 dark:hover:bg-neutral-800 border border-neutral-200 dark:border-neutral-800 rounded-md disabled:opacity-50" :disabled="connecting()" @click="connectProject()" data-fettler-open>Open project</button>
        <button type="button" class="px-2.5 h-7 text-xs bg-white dark:bg-neutral-900 hover:bg-neutral-100 dark:hover:bg-neutral-800 border border-neutral-200 dark:border-neutral-800 rounded-md disabled:opacity-50" :disabled="connecting()" @click="connect({ kind: 'sandbox' })" data-fettler-sandbox>Sandbox</button>
        <button type="button" class="px-2.5 h-7 text-xs bg-white dark:bg-neutral-900 hover:bg-neutral-100 dark:hover:bg-neutral-800 border border-neutral-200 dark:border-neutral-800 rounded-md" @click="connectOpen.set(true)" data-fettler-remote>Remote</button>
        <button type="button" class="px-2.5 h-7 text-neutral-500 text-xs bg-white dark:bg-neutral-900 hover:bg-neutral-100 dark:hover:bg-neutral-800 border border-neutral-200 dark:border-neutral-800 rounded-md" @click="openPalette()" aria-label="Open the command palette" data-fettler-palette-open>Cmd+K</button>
        <button type="button" class="px-3 h-7 font-medium text-white text-xs bg-neutral-900 dark:bg-neutral-100 dark:text-neutral-900 rounded-md disabled:opacity-40" :disabled="running() || !connected()" @click="runAll()" data-fettler-run>{{ running() ? 'Running' : 'Run' }}</button>
      </header>

      @if(notice())
        <p class="px-3 py-1.5 text-amber-800 text-xs dark:text-amber-300 bg-amber-50 dark:bg-amber-500/10 border-b border-amber-200 dark:border-amber-500/20" role="status" data-fettler-notice>{{ notice() }}</p>
      @endif

      @if(confirming())
        <div class="flex gap-3 items-center px-3 py-2 text-red-900 text-xs dark:text-red-100 bg-red-50 dark:bg-red-500/15 border-b border-red-200 dark:border-red-500/30" role="alert" data-fettler-confirm>
          <span class="flex-1">This will run on <strong>{{ environmentLabel() }}</strong> at {{ whereLabel() || targetLabel() }}. Anything it writes is written for real.</span>
          <button type="button" class="px-2.5 h-6 text-xs bg-white dark:bg-neutral-900 border border-red-300 dark:border-red-500/40 rounded" @click="confirming.set('')">Cancel</button>
          <button type="button" class="px-2.5 h-6 font-medium text-white text-xs bg-red-600 rounded" @click="guarded(confirming())" data-fettler-confirm-run>Run on {{ environmentLabel() }}</button>
        </div>
      @endif

      <main class="flex-1 grid grid-cols-2 min-h-0">
        <section class="min-h-0 min-w-0 border-r border-neutral-200 dark:border-neutral-800" aria-label="Code">
          <CodeEditor
            language="typescript"
            height="100%"
            label="Code to run"
            v-model:value="code"
            @ref="editorRef"
            :diagnostics="diagnostics()"
            :widgets="widgets()"
            :autoComplete="true"
            :ghostText="ghost()"
            @selection="onSelection($event)"
            @input="scheduleCheck(); scheduleSuggest()"
            @complete="complete($event)"
            @run="runAll($event)"
            @run-selection="runSelection($event)"
          />
        </section>

        <section class="flex flex-col min-h-0 min-w-0" aria-label="Result and logs">
          <div class="flex gap-1 items-center px-2 h-9 border-b border-neutral-200 dark:border-neutral-800 shrink-0" role="tablist">
            <button type="button" role="tab" :aria-selected="view() === 'result' ? 'true' : 'false'" :class="view() === 'result' ? 'px-2.5 h-6 text-xs font-medium bg-neutral-200 dark:bg-neutral-800 rounded' : 'px-2.5 h-6 text-xs text-neutral-500 rounded'" @click="showView('result')" data-fettler-tab-result>Result</button>
            <button type="button" role="tab" :aria-selected="view() === 'logs' ? 'true' : 'false'" :class="view() === 'logs' ? 'px-2.5 h-6 text-xs font-medium bg-neutral-200 dark:bg-neutral-800 rounded' : 'px-2.5 h-6 text-xs text-neutral-500 rounded'" @click="showView('logs')" data-fettler-tab-logs>Logs</button>
            <button type="button" role="tab" :aria-selected="view() === 'assistant' ? 'true' : 'false'" :class="view() === 'assistant' ? 'px-2.5 h-6 text-xs font-medium bg-neutral-200 dark:bg-neutral-800 rounded' : 'px-2.5 h-6 text-xs text-neutral-500 rounded'" @click="showView('assistant')" data-fettler-tab-assistant>Assistant</button>
            <button type="button" role="tab" :aria-selected="view() === 'info' ? 'true' : 'false'" :class="view() === 'info' ? 'px-2.5 h-6 text-xs font-medium bg-neutral-200 dark:bg-neutral-800 rounded' : 'px-2.5 h-6 text-xs text-neutral-500 rounded'" @click="showView('info')" data-fettler-tab-info>Info</button>
            @if(view() === 'logs')
              <select :value="logLevel()" @change="logLevel.set($event.target.value)" aria-label="Lowest level to show" class="ml-auto px-1.5 h-6 text-xs bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded">
                <option value="all">All levels</option>
                <option value="info">Info and up</option>
                <option value="warning">Warnings and errors</option>
                <option value="error">Errors</option>
              </select>
              <input type="text" :value="logQuery()" @input="logQuery.set($event.target.value)" placeholder="Filter" aria-label="Filter log lines" class="px-2 w-40 h-6 text-xs bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded focus:outline-none">
              <span class="text-[11px] text-neutral-400" data-fettler-log-state>{{ logFollowing() ? 'following' : 'stopped' }}</span>
            @endif
          </div>

          @if(view() === 'logs')
            <div class="flex-1 min-h-0 overflow-y-auto p-2 font-mono text-[11px] leading-5" data-fettler-logs>
              @if(logNote())
                <p class="px-1 text-red-700 dark:text-red-300" role="alert">{{ logNote() }}</p>
              @endif
              @foreach(shownLogs() as line)
                <div :class="logClass(line.level)" class="flex gap-2 px-1"><span class="text-neutral-400 shrink-0">{{ line.time ? line.time.slice(11, 19) : '' }}</span><span class="w-12 uppercase shrink-0">{{ line.level }}</span><span class="min-w-0 break-words whitespace-pre-wrap">{{ line.message }}</span></div>
              @endforeach
              @if(!logNote() && shownLogs().length === 0)
                <p class="px-1 text-neutral-500">{{ connected() ? 'No lines yet.' : 'Open a project to follow its log.' }}</p>
              @endif
            </div>
          @endif

          @if(view() === 'info')
            <div class="flex-1 min-h-0 overflow-y-auto p-3 space-y-3" data-fettler-info>
              @if(!connected())
                <p class="text-neutral-500 text-sm">Open a project to see what it is running on.</p>
              @endif
              @if(panelsNote())
                <p class="text-red-700 text-xs dark:text-red-300" role="alert">{{ panelsNote() }}</p>
              @endif
              @foreach(panels() as panel)
                <article class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-lg">
                  <h2 class="px-3 py-1.5 font-medium text-xs border-b border-neutral-200 dark:border-neutral-800">{{ panel.title }}</h2>
                  @foreach(panel.sections as section)
                    @if(section.title)
                      <h3 class="px-3 pt-2 text-[10px] text-neutral-400 uppercase tracking-wide">{{ section.title }}</h3>
                    @endif
                    <dl class="px-3 py-1.5">
                      @foreach(section.rows as row)
                        <div class="flex gap-3 py-0.5 text-xs"><dt class="w-32 text-neutral-500 shrink-0">{{ row[0] }}</dt><dd class="min-w-0 font-mono break-words">{{ row[1] }}</dd></div>
                      @endforeach
                    </dl>
                  @endforeach
                </article>
              @endforeach
            </div>
          @endif

          @if(view() === 'assistant')
            <div class="flex flex-col flex-1 min-h-0" data-fettler-assistant>
              <div class="flex-1 min-h-0 overflow-y-auto p-3 space-y-3">
                @if(!ai().enabled || !ai().hasKey)
                  <div class="p-3 text-neutral-600 text-sm dark:text-neutral-300 bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-lg">
                    <p>The assistant uses your own API key. It is kept in this computer's keychain. Only your code, your question and the names of your models and columns are sent, never rows of data.</p>
                    <button type="button" class="mt-3 px-3 h-7 font-medium text-white text-xs bg-neutral-900 dark:bg-neutral-100 dark:text-neutral-900 rounded-md" @click="aiOpen.set(true)">Set up AI</button>
                  </div>
                @endif
                @foreach(chat() as message)
                  <div :class="message.role === 'user' ? 'ml-8 p-2.5 text-sm bg-neutral-200 dark:bg-neutral-800 rounded-lg' : 'mr-8 p-2.5 text-sm bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-lg'">
                    <pre class="font-sans whitespace-pre-wrap break-words">{{ message.content }}</pre>
                    @if(message.code)
                      <button type="button" class="mt-2 px-2.5 h-6 text-xs border border-neutral-300 dark:border-neutral-700 rounded" @click="useCode(message.code)">Put this code in the editor</button>
                    @endif
                  </div>
                @endforeach
                @if(asking())
                  <p class="text-neutral-500 text-xs">Thinking</p>
                @endif
                @if(chatNote())
                  <p class="text-red-700 text-xs dark:text-red-300" role="alert">{{ chatNote() }}</p>
                @endif
              </div>
              <div class="flex gap-2 p-2 border-t border-neutral-200 dark:border-neutral-800">
                <input type="text" :value="question()" @input="question.set($event.target.value)" @keydown.enter="ask()" placeholder="Describe what you want the code to do" aria-label="Question for the assistant" class="flex-1 px-2.5 h-8 text-sm bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-md focus:outline-none focus:border-neutral-400">
                <button type="button" class="px-3 h-8 font-medium text-white text-xs bg-neutral-900 dark:bg-neutral-100 dark:text-neutral-900 rounded-md disabled:opacity-40" :disabled="asking()" @click="ask()">Ask</button>
              </div>
            </div>
          @endif

          <div :class="view() === 'result' ? 'flex flex-col flex-1 gap-3 p-3 min-h-0 overflow-y-auto' : 'hidden'" aria-live="polite">
          @if(!connected())
            <p class="text-neutral-500 text-sm dark:text-neutral-400">Open a project or the sandbox, then run with Cmd+Enter.</p>
          @endif

          @if(output())
            <article class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-lg" data-fettler-output>
              <h2 class="px-3 py-1.5 font-medium text-[11px] text-neutral-500 border-b border-neutral-200 dark:border-neutral-800">Output</h2>
              <pre class="p-3 overflow-x-auto font-mono text-xs whitespace-pre-wrap">{{ output() }}</pre>
            </article>
          @endif

          @if(result())
            <article class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-lg" data-fettler-result>
              <h2 class="flex justify-between px-3 py-1.5 font-medium text-[11px] text-neutral-500 border-b border-neutral-200 dark:border-neutral-800"><span>Result</span><span class="font-mono">{{ duration() }}</span></h2>
              <pre class="p-3 overflow-x-auto font-mono text-xs whitespace-pre-wrap">{{ result() }}</pre>
            </article>
          @endif

          @if(failure())
            <article class="bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30 rounded-lg" data-fettler-error>
              <h2 class="flex justify-between px-3 py-1.5 font-medium text-[11px] text-red-700 dark:text-red-300 border-b border-red-200 dark:border-red-500/30"><span>Error</span><span class="font-mono">{{ duration() }}</span></h2>
              <pre class="p-3 overflow-x-auto font-mono text-red-800 text-xs dark:text-red-200 whitespace-pre-wrap">{{ failure() }}</pre>
            </article>
          @endif

          @if(queries().length)
            <article class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-lg" data-fettler-queries>
              <h2 class="px-3 py-1.5 font-medium text-[11px] text-neutral-500 border-b border-neutral-200 dark:border-neutral-800">Queries ({{ queries().length }})</h2>
              <ul class="divide-neutral-200 divide-y dark:divide-neutral-800">
                @foreach(queries() as query)
                  <li class="flex gap-3 px-3 py-1.5 font-mono text-xs"><span class="text-neutral-400 shrink-0">{{ query.durationMs }} ms</span><span class="min-w-0 break-words">{{ query.sql }}</span></li>
                @endforeach
              </ul>
            </article>
          @endif
          </div>
        </section>
      </main>

      @if(mcpOpen())
        <div class="fixed inset-0 z-40 flex items-start justify-center pt-20 bg-black/30" @click.self="mcpOpen.set(false)" data-fettler-mcp>
          <div class="w-full max-w-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 rounded-xl shadow-2xl" role="dialog" aria-modal="true" aria-label="MCP settings">
            <div class="grid gap-3 p-4">
              <p class="text-sm">Let an AI tool such as Claude or Cursor run code through Fettler, in the connections you have opened. It works while Fettler is open.</p>
              <p class="text-[11px] text-neutral-500">A production connection is refused unless the tool is told to confirm it. Turning this on makes a new token and ends the old one.</p>
              @if(mcp().enabled)
                <pre class="p-3 overflow-x-auto font-mono text-[11px] bg-neutral-100 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-md" data-fettler-mcp-config>{{ mcpConfig() }}</pre>
                @if(!mcp().token)
                  <p class="text-[11px] text-neutral-500">The token was shown once when this was turned on. Turn it off and on again for a new one.</p>
                @endif
              @endif
            </div>
            <div class="flex gap-2 justify-end px-4 py-3 border-t border-neutral-200 dark:border-neutral-800">
              <button type="button" class="px-3 h-8 text-xs border border-neutral-200 dark:border-neutral-700 rounded-md" @click="mcpOpen.set(false)">Close</button>
              @if(mcp().enabled)
                <button type="button" class="px-3 h-8 text-xs border border-neutral-200 dark:border-neutral-700 rounded-md" @click="setMcp(false)">Turn off</button>
              @endif
              @if(!mcp().enabled)
                <button type="button" class="px-3 h-8 font-medium text-white text-xs bg-neutral-900 dark:bg-neutral-100 dark:text-neutral-900 rounded-md" @click="setMcp(true)">Turn on</button>
              @endif
            </div>
          </div>
        </div>
      @endif

      @if(aiOpen())
        <div class="fixed inset-0 z-40 flex items-start justify-center pt-20 bg-black/30" @click.self="aiOpen.set(false)" data-fettler-ai-settings>
          <div class="w-full max-w-md bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 rounded-xl shadow-2xl" role="dialog" aria-modal="true" aria-label="AI settings">
            <div class="grid gap-3 p-4">
              <label class="flex gap-2 items-center text-sm"><input type="checkbox" :checked="ai().enabled" @change="setAi('enabled', $event.target.checked)"> Use AI in Fettler</label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Provider
                <select :value="ai().provider" @change="setAi('provider', $event.target.value)" class="px-2 h-8 text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-700 rounded-md">
                  <option value="anthropic">Anthropic</option>
                  <option value="openai">OpenAI</option>
                  <option value="ollama">Ollama (runs on this computer)</option>
                </select>
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Model (optional)
                <input type="text" :value="ai().model" @input="setAi('model', $event.target.value)" placeholder="The provider's fast model" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-700 rounded-md focus:outline-none">
              </label>
              @if(ai().provider === 'ollama')
                <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Ollama address
                  <input type="text" :value="ai().host" @input="setAi('host', $event.target.value)" placeholder="http://127.0.0.1:11434" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-700 rounded-md focus:outline-none">
                </label>
              @endif
              @if(ai().provider !== 'ollama')
                <label class="flex flex-col gap-1 text-[11px] text-neutral-500">{{ ai().hasKey ? 'API key (one is saved; type to replace it)' : 'API key' }}
                  <input type="password" :value="aiKey()" @input="aiKey.set($event.target.value)" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-700 rounded-md focus:outline-none">
                </label>
              @endif
              <label class="flex gap-2 items-center text-sm"><input type="checkbox" :checked="ai().automatic" @change="setAi('automatic', $event.target.checked)"> Suggest after a pause, not only on Alt+Backslash</label>
              <p class="text-[11px] text-neutral-500">The key is stored in this computer's keychain and is never shown again. Requests carry your code, your question and the names of your models and columns.</p>
            </div>
            <div class="flex gap-2 justify-end px-4 py-3 border-t border-neutral-200 dark:border-neutral-800">
              @if(ai().hasKey && ai().provider !== 'ollama')
                <button type="button" class="mr-auto px-3 h-8 text-red-700 text-xs dark:text-red-300 border border-neutral-200 dark:border-neutral-700 rounded-md" @click="forgetKey()">Forget the key</button>
              @endif
              <button type="button" class="px-3 h-8 text-xs border border-neutral-200 dark:border-neutral-700 rounded-md" @click="aiOpen.set(false)">Cancel</button>
              <button type="button" class="px-3 h-8 font-medium text-white text-xs bg-neutral-900 dark:bg-neutral-100 dark:text-neutral-900 rounded-md disabled:opacity-50" :disabled="aiSaving()" @click="saveAi()">Save</button>
            </div>
          </div>
        </div>
      @endif

      @if(connectOpen())
        <div class="fixed inset-0 z-40 flex items-start justify-center pt-16 bg-black/30" @click.self="connectOpen.set(false)" data-fettler-connect>
          <div class="w-full max-w-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 rounded-xl shadow-2xl" role="dialog" aria-modal="true" aria-label="Connect to a remote target">
            <div class="flex gap-1 p-2 border-b border-neutral-200 dark:border-neutral-800" role="tablist">
              <button type="button" role="tab" :aria-selected="connectKind() === 'ssh' ? 'true' : 'false'" :class="connectKind() === 'ssh' ? 'px-3 h-7 text-xs font-medium bg-neutral-100 dark:bg-neutral-800 rounded-md' : 'px-3 h-7 text-xs text-neutral-500 rounded-md'" @click="connectKind.set('ssh'); found.set([])">SSH</button>
              <button type="button" role="tab" :aria-selected="connectKind() === 'docker' ? 'true' : 'false'" :class="connectKind() === 'docker' ? 'px-3 h-7 text-xs font-medium bg-neutral-100 dark:bg-neutral-800 rounded-md' : 'px-3 h-7 text-xs text-neutral-500 rounded-md'" @click="connectKind.set('docker'); found.set([])">Docker</button>
              <button type="button" role="tab" :aria-selected="connectKind() === 'kube' ? 'true' : 'false'" :class="connectKind() === 'kube' ? 'px-3 h-7 text-xs font-medium bg-neutral-100 dark:bg-neutral-800 rounded-md' : 'px-3 h-7 text-xs text-neutral-500 rounded-md'" @click="connectKind.set('kube'); found.set([])">Kubernetes</button>
            </div>
            <div class="grid gap-3 grid-cols-2 p-4">
              @if(connectKind() === 'ssh')
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Host
                <input type="text" :value="form().host" @input="setField('host', $event.target.value)" placeholder="box.example.com" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-700 rounded-md focus:outline-none focus:border-neutral-400">
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">User
                <input type="text" :value="form().user" @input="setField('user', $event.target.value)" placeholder="root" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-700 rounded-md focus:outline-none focus:border-neutral-400">
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Port
                <input type="text" :value="form().port" @input="setField('port', $event.target.value)" placeholder="22" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-700 rounded-md focus:outline-none focus:border-neutral-400">
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Jump host (optional)
                <input type="text" :value="form().jump" @input="setField('jump', $event.target.value)" placeholder="me@bastion" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-700 rounded-md focus:outline-none focus:border-neutral-400">
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500" style="grid-column: span 2">Identity file (optional)
                <input type="text" :value="form().identityFile" @input="setField('identityFile', $event.target.value)" placeholder="/Users/me/.ssh/id_ed25519" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-700 rounded-md focus:outline-none focus:border-neutral-400">
              </label>
              @endif
              @if(connectKind() === 'kube')
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Context (optional)
                <input type="text" :value="form().context" @input="setField('context', $event.target.value)" placeholder="current context" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-700 rounded-md focus:outline-none focus:border-neutral-400">
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Namespace
                <input type="text" :value="form().namespace" @input="setField('namespace', $event.target.value)" placeholder="default" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-700 rounded-md focus:outline-none focus:border-neutral-400">
              </label>
              @endif
              @if(connectKind() !== 'docker')
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Pod
                <input type="text" :value="form().pod" @input="setField('pod', $event.target.value)" placeholder="api-0" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-700 rounded-md focus:outline-none focus:border-neutral-400">
              </label>
              @endif
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Container
                <input type="text" :value="form().container" @input="setField('container', $event.target.value)" placeholder="web-1" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-700 rounded-md focus:outline-none focus:border-neutral-400">
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500" style="grid-column: span 2">Project directory on the target
                <input type="text" :value="form().directory" @input="setField('directory', $event.target.value)" placeholder="/var/www/app/current" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-700 rounded-md focus:outline-none focus:border-neutral-400">
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Env file to export (optional)
                <input type="text" :value="form().envFile" @input="setField('envFile', $event.target.value)" placeholder=".env" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-700 rounded-md focus:outline-none focus:border-neutral-400">
              </label>
              <div class="flex flex-wrap gap-2 items-end">
                <button type="button" class="px-2.5 h-8 text-xs border border-neutral-200 dark:border-neutral-700 rounded-md disabled:opacity-50" :disabled="finding()" @click="discover('containers')">List containers</button>
                <button type="button" class="px-2.5 h-8 text-xs border border-neutral-200 dark:border-neutral-700 rounded-md disabled:opacity-50" :disabled="finding()" @click="discover('pods')">List pods</button>
              </div>
            </div>
            @if(found().length)
              <ul class="mx-4 mb-3 max-h-40 overflow-y-auto border border-neutral-200 dark:border-neutral-700 rounded-md divide-neutral-200 divide-y dark:divide-neutral-800" data-fettler-found>
                @foreach(found() as item)
                  <li class="flex gap-3 px-3 py-1.5 font-mono text-xs cursor-default hover:bg-neutral-100 dark:hover:bg-neutral-800" @click="pick(item)"><span>{{ item.value }}</span><span class="ml-auto text-neutral-400 truncate">{{ item.hint }}</span></li>
                @endforeach
              </ul>
            @endif
            <p class="px-4 pb-3 text-[11px] text-neutral-500">Keys come from your SSH agent. Fettler never asks for a password and writes nothing on the target.</p>
            <div class="flex gap-2 justify-end px-4 py-3 border-t border-neutral-200 dark:border-neutral-800">
              <button type="button" class="px-3 h-8 text-xs border border-neutral-200 dark:border-neutral-700 rounded-md" @click="connectOpen.set(false)">Cancel</button>
              <button type="button" class="px-3 h-8 font-medium text-white text-xs bg-neutral-900 dark:bg-neutral-100 dark:text-neutral-900 rounded-md disabled:opacity-50" :disabled="connecting()" @click="connectRemote()" data-fettler-connect-go>{{ connecting() ? 'Connecting' : 'Connect' }}</button>
            </div>
          </div>
        </div>
      @endif

      @if(paletteOpen())
        <div class="fixed inset-0 z-40 flex items-start justify-center pt-24 bg-black/30" @click.self="closePalette()" data-fettler-palette>
          <div class="w-full max-w-xl overflow-hidden bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 rounded-xl shadow-2xl" role="dialog" aria-modal="true" aria-label="Command palette">
            <input
              ref="paletteInput"
              type="text"
              role="combobox"
              aria-expanded="true"
              aria-controls="fettler-palette-list"
              aria-label="Search commands, projects, snippets and history"
              placeholder="Search commands, projects, snippets and history"
              :value="paletteQuery()"
              @input="paletteQuery.set($event.target.value); paletteActive.set(0)"
              @keydown="paletteKey($event)"
              class="px-4 w-full h-12 text-sm bg-transparent border-b border-neutral-200 dark:border-neutral-800 focus:outline-none"
            >
            <ul id="fettler-palette-list" role="listbox" class="py-1 max-h-96 overflow-y-auto">
              @foreach(paletteItems() as item, index)
                <li
                  role="option"
                  :aria-selected="index === paletteActive() ? 'true' : 'false'"
                  :class="index === paletteActive() ? 'flex gap-3 items-baseline px-4 py-2 cursor-default bg-neutral-100 dark:bg-neutral-800' : 'flex gap-3 items-baseline px-4 py-2 cursor-default'"
                  @click="choose(item)"
                  @mousemove="paletteActive.set(index)"
                >
                  <span class="w-14 text-[10px] text-neutral-400 uppercase tracking-wide shrink-0">{{ item.kind }}</span>
                  <span class="min-w-0 font-mono text-xs truncate">{{ item.title }}</span>
                  <span class="ml-auto min-w-0 text-[11px] text-neutral-400 truncate">{{ item.hint }}</span>
                </li>
              @endforeach
              @if(paletteItems().length === 0)
                <li class="px-4 py-3 text-neutral-500 text-sm">Nothing matches.</li>
              @endif
            </ul>
          </div>
        </div>
      @endif
    </div>
  </body>
</html>
