<script client>
import { fuzzyFilter } from '../functions/fuzzy'
import { componentApi } from '@stacksjs/components/component-api'
import { modelsIn, neighbourhood } from '../functions/relation-graph'
import { DEFAULT_PREFERENCES, editorStyle as editorStyleOf } from '../../app/TinkerBelle/preferences'
import { announcePreferences, dragWindowFrom, onPreferences, onSettingsRequested, openSettingsWindow, restartToFinishUpdate } from '../functions/desktop-bridge'
import { trimHover } from '../functions/hover-text'
import { gridOf } from '../functions/tinker-table'
import { renderTinkerValue } from '../functions/tinker-value'

const code = state('const numbers = [1, 2, 3]\nnumbers.map(n => n * 2)\n')
const connection = state(null)
const projectPath = state('')
const connecting = state(false)
const running = state(false)
const notice = state('')
const output = state('')
const result = state('')
const failure = state('')
const duration = state('')
const queries = state([])

const widgets = state([])
const recent = state([])
const snippets = state([])
const historyEntries = state([])
const paletteOpen = state(false)
const paletteQuery = state('')
const paletteActive = state(0)
const paletteInput = useRef('paletteInput')
const diagnostics = state([])
const editorRef = ref()
let checkTimer = 0
let checkSerial = 0

const view = state('result')
// The window is the editor. The side pane opens when there is something to show in it.
const paneOpen = state(false)
const switcherOpen = state(false)
const caretLabel = state('Ln 1, Col 1')
const MOD = /Mac|iPhone|iPad/i.test(navigator.userAgent) ? 'Cmd' : 'Ctrl'
const MOD_KEY = MOD === 'Cmd' ? '\u2318' : 'Ctrl'
const RUN_KEYS = MOD === 'Cmd' ? '\u2318\u21B5' : 'Ctrl+Enter'
const logLines = state([])
const logLevel = state('all')
const logQuery = state('')
const logFollowing = state(false)
const logNote = state('')
let logAbort = null

const LOG_RANK = { debug: 0, info: 1, success: 1, warning: 2, error: 3 }
const shownLogs = derived(() => {
  const floor = logLevel() === 'all' ? -1 : LOG_RANK[logLevel()]
  const query = logQuery().trim().toLowerCase()
  return logLines().filter(line => LOG_RANK[line.level] >= floor && (!query || line.raw.toLowerCase().includes(query)))
})

function stopLogs() {
  if (logAbort) logAbort.abort()
  logAbort = null
  logFollowing.set(false)
}

// Lines are read from a response that stays open: each one is shown as the target writes it.
async function followLogs() {
  stopLogs()
  logLines.set([])
  logNote.set('')
  if (!connected()) return
  logAbort = new AbortController()
  logFollowing.set(true)
  try {
    const response = await fetch('/__tinkerbelle/logs', { signal: logAbort.signal })
    if (!response.ok || !response.body) {
      const body = await response.json().catch(() => ({}))
      logNote.set(body.error || 'The log could not be followed.')
      return
    }
    const reader = response.body.getReader()
    const decoder = new TextDecoder()
    let pending = ''
    for (;;) {
      const { value, done } = await reader.read()
      if (done) break
      pending += decoder.decode(value, { stream: true })
      const parts = pending.split('\n')
      pending = parts.pop() || ''
      const fresh = parts.filter(Boolean).map(part => JSON.parse(part))
      if (fresh.length) logLines.set([...logLines(), ...fresh].slice(-2000))
    }
  }
  catch (cause) {
    if (!(cause && cause.name === 'AbortError')) logNote.set(cause instanceof Error ? cause.message : 'The log stopped.')
  }
  finally {
    logFollowing.set(false)
  }
}

function showView(name) {
  view.set(name)
  paneOpen.set(true)
  if (name === 'logs' && !logFollowing()) void followLogs()
  if (name === 'info') void loadPanels()
  if (name !== 'logs') stopLogs()
}

function logClass(level) {
  if (level === 'error') return 'tb-danger-fg'
  if (level === 'warning') return 'tb-warn-fg'
  if (level === 'debug') return 'tb-fg-3'
  return 'tb-fg-2'
}

const ai = state({ enabled: false, provider: 'anthropic', model: '', host: '', automatic: false, hasKey: false })
const chat = state([])
const question = state('')
const asking = state(false)
const chatNote = state('')
const ghost = state('')
let ghostTimer = 0
let ghostAbort = null
let caret = { line: 0, column: 0 }

async function loadAi() {
  const response = await fetch('/__tinkerbelle/ai')
  if (response.ok) ai.set(await response.json())
}




function offsetOf(text, line, column) {
  const lines = text.split('\n')
  let offset = 0
  for (let index = 0; index < line && index < lines.length; index++) offset += lines[index].length + 1
  return offset + column
}

// A suggestion at the cursor. Asked for with Alt+Backslash, or after a pause when that is turned on.
async function suggest() {
  if (!ai().enabled || !ai().hasKey) return
  if (ghostAbort) ghostAbort.abort()
  ghostAbort = new AbortController()
  const text = code()
  const at = offsetOf(text, caret.line, caret.column)
  try {
    const response = await fetch('/__tinkerbelle/ai/suggest', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ before: text.slice(0, at), after: text.slice(at) }),
      signal: ghostAbort.signal,
    })
    const body = await response.json()
    ghost.set(response.ok ? (body.suggestion || '') : '')
    if (!response.ok && body.error) notice.set(body.error)
  }
  catch (cause) {
    if (!(cause && cause.name === 'AbortError')) ghost.set('')
  }
}

function scheduleSuggest() {
  clearTimeout(ghostTimer)
  ghost.set('')
  if (ai().enabled && ai().automatic && ai().hasKey) ghostTimer = setTimeout(suggest, 700)
}

function onSelection(detail) {
  if (!detail) return
  caret = { line: detail.line, column: detail.column }
  caretLabel.set(`Ln ${detail.line + 1}, Col ${detail.column + 1}`)
}

async function ask() {
  const text = question().trim()
  if (!text || asking()) return
  const messages = [...chat(), { role: 'user', content: text }]
  chat.set(messages)
  question.set('')
  asking.set(true)
  chatNote.set('')
  try {
    const response = await fetch('/__tinkerbelle/ai/ask', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ messages: messages.map(message => ({ role: message.role, content: message.content })), code: code() }),
    })
    const body = await response.json()
    if (!response.ok) {
      chatNote.set(body.error || 'The assistant could not answer.')
      if (body.notReady) void openSettingsWindow('ai')
      return
    }
    chat.set([...messages, { role: 'assistant', content: body.answer, code: body.code }])
  }
  catch (cause) {
    chatNote.set(cause instanceof Error ? cause.message : 'The assistant could not answer.')
  }
  finally {
    asking.set(false)
  }
}

function useCode(source) {
  code.set(source)
  scheduleCheck()
  showView('result')
}

const panels = state([])
const panelsNote = state('')

async function loadPanels() {
  panels.set([])
  panelsNote.set('')
  if (!connected()) return
  const response = await fetch('/__tinkerbelle/panels')
  const body = await response.json().catch(() => ({}))
  panels.set(body.panels || [])
  if (body.error) panelsNote.set(body.error)
}

const boxes = state([])
const boxesNote = state('')
const boxesLoading = state(false)

// The servers this project is deployed to, as the project itself reports them.
async function loadBoxes() {
  boxesLoading.set(true)
  boxes.set([])
  boxesNote.set('')
  try {
    const response = await fetch('/__tinkerbelle/boxes', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ environment: 'production' }) })
    const body = await response.json()
    if (!response.ok) throw new Error(body.error || 'The deploys could not be listed.')
    boxes.set(body.targets || [])
    // The project's own words when it has them: "not deployed from this checkout" is more use than "none".
    boxesNote.set((body.warnings || []).join(' ') || (body.targets && body.targets.length ? '' : 'This project has no server deploys for production.'))
  }
  catch (cause) {
    boxesNote.set(cause instanceof Error ? cause.message : 'The deploys could not be listed.')
  }
  finally {
    boxesLoading.set(false)
  }
}

async function connectBox(target) {
  await connect(target.connection)
  if (connected() && connection().kind === 'ssh') connectOpen.set(false)
}

const license = state({ pro: false, source: 'none', standing: null, version: '', buildDate: '' })


async function loadLicense() {
  const response = await fetch('/__tinkerbelle/license')
  if (response.ok) license.set(await response.json())
}



// Updates: the launcher checks by itself; the window only says when there is one and installs it when asked.
const update = state({ state: 'idle', currentVersion: '', selfUpdating: false })
const updateBusy = state(false)
const updateReady = derived(() => update().state === 'available' && Boolean(update().version))
const updateInstalled = derived(() => update().state === 'installed')

async function restartForUpdate() {
  if (!(await restartToFinishUpdate()))
    notice.set('Quit TinkerBelle and open it again to finish the update.')
}

async function loadUpdate() {
  const response = await fetch('/__desktop/update').catch(() => null)
  // Run from source there is no launcher, and nothing to update.
  if (response && response.ok) update.set(await response.json())
}

async function checkForUpdate() {
  updateBusy.set(true)
  try {
    const response = await fetch('/__desktop/update', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'check' }) }).catch(() => null)
    if (!response || !response.ok) {
      notice.set('Updates are checked by the installed app. This copy is running from source.')
      return
    }
    update.set(await response.json())
    const now = update()
    if (now.state === 'current') notice.set(`TinkerBelle ${now.currentVersion} is the newest version.`)
    else if (now.state === 'error' || now.state === 'refused') notice.set(now.error || now.message || 'The update check did not finish.')
  }
  finally {
    updateBusy.set(false)
  }
}

let updateWarned = false

async function installUpdate() {
  const now = update()
  // A warning (a license whose updates ended before this version, say) is shown once, and the second click goes ahead.
  if (now.warning && !updateWarned) {
    updateWarned = true
    notice.set(`${now.warning} Choose the update again to install it anyway.`)
    return
  }
  updateBusy.set(true)
  try {
    const response = await fetch('/__desktop/update', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'install', acknowledge: updateWarned }) })
    const body = await response.json().catch(() => ({}))
    update.set({ ...now, ...body })
    if (body.state === 'error' || body.state === 'refused') notice.set(body.error || body.message || 'The update could not be installed.')
    else if (body.message) notice.set(body.message)
  }
  catch (cause) {
    notice.set(cause instanceof Error ? cause.message : 'The update could not be installed.')
  }
  finally {
    updateBusy.set(false)
  }
}

const mcp = state({ enabled: false, address: '', token: '' })

async function loadMcp() {
  const response = await fetch('/__tinkerbelle/mcp-settings')
  if (response.ok) mcp.set({ token: '', ...(await response.json()) })
}



const lastValue = state(null)
const resultView = state('text')

// A scalar reads best as text. Anything with parts gets the inspector.
const SCALARS = ['string', 'number', 'boolean', 'bigint', 'null', 'undefined', 'date', 'url', 'regexp', 'symbol']
const inspectable = derived(() => Boolean(lastValue()) && !SCALARS.includes(lastValue().t) && lastValue().t !== 'html')
const grid = derived(() => gridOf(lastValue()))
const previewMarkup = derived(() => lastValue() && lastValue().t === 'html' ? lastValue().html : '')

// The relation graph is drawn from the session's own list of models, asked for once per connection.
const modelList = state(null)
const resultModels = derived(() => modelsIn(lastValue()))
const relations = derived(() => modelList() && resultModels().length ? neighbourhood(modelList(), resultModels()) : { nodes: [], edges: [] })

async function loadModels() {
  if (modelList()) return
  const response = await fetch('/__tinkerbelle/models')
  modelList.set(response.ok ? (await response.json()).models || [] : [])
}

function showGraph() {
  resultView.set('graph')
  void loadModels()
}

function expandRelations(detail) {
  if (!detail || !detail.node || !modelList()) return
  const more = neighbourhood(modelList(), [detail.node.id])
  const graph = componentApi('tinkerbelle-relations')
  graph.addNeighbours(detail.node.id, more.nodes.filter(node => node.id !== detail.node.id), more.edges)
  graph.updateNode(detail.node.id, { expandable: false })
}

// A node in the inspector that is a list of records or a page opens in the view made for it.
function openNode(detail) {
  if (!detail) return
  if (detail.as === 'table' && grid()) resultView.set('table')
  else if (detail.as === 'preview' && previewMarkup()) resultView.set('preview')
  else if (detail.as === 'graph' && resultModels().length) showGraph()
}

const PALETTE_ICONS = { project: 'i-hugeicons-folder-01', snippet: 'i-hugeicons-note-01', history: 'i-hugeicons-clock-01', ssh: 'i-hugeicons-cloud-server', docker: 'i-hugeicons-package', kube: 'i-hugeicons-package' }
const PANE_VIEWS = [{ id: 'result', title: 'Result' }, { id: 'logs', title: 'Log' }, { id: 'assistant', title: 'Assistant' }, { id: 'info', title: 'Info' }]

const VIEW_ON = 'px-1.5 h-5 rounded tb-fill tb-fg'
const VIEW_OFF = 'px-1.5 h-5 rounded tb-hover-fg'

const tabs = state([{ id: 't1', title: 'Untitled', code: code() }])
const activeTab = state('t1')
// The preferences Settings changes (app/TinkerBelle/preferences.ts holds the list and its defaults).
const ui = state({ ...DEFAULT_PREFERENCES })
let saveTimer = 0
let tabCounter = 1

// "System" follows the machine: the dark variants are class based, so the class is set from the media query.
const systemDark = useMediaQuery('(prefers-color-scheme: dark)')
const themeClass = derived(() => ui().theme === 'dark' || (ui().theme !== 'light' && systemDark()) ? 'dark' : 'light')
// The code's colours follow the same class the window does, so a chosen theme and the system's never disagree.
const editorTheme = derived(() => themeClass())
// The editor sets its own size on itself, which an inherited value cannot change: the page's rule below hands these to it.
const editorStyle = derived(() => editorStyleOf(ui()))

function tabTitle(tab) {
  const line = (tab.code || '').split('\n').find(part => part.trim()) || ''
  return line ? (line.length > 22 ? `${line.slice(0, 22)}...` : line) : 'Untitled'
}

// The buffers are written a moment after the last change, so closing the window loses nothing.
function scheduleSave() {
  clearTimeout(saveTimer)
  saveTimer = setTimeout(() => {
    const current = tabs().map(tab => tab.id === activeTab() ? { ...tab, code: code() } : tab)
    void fetch('/__tinkerbelle/workspace', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ tabs: current, active: activeTab() }) })
  }, 500)
}

function selectTab(id) {
  if (id === activeTab()) return
  tabs.set(tabs().map(tab => tab.id === activeTab() ? { ...tab, code: code() } : tab))
  const next = tabs().find(tab => tab.id === id)
  if (!next) return
  activeTab.set(id)
  code.set(next.code)
  widgets.set([])
  ghost.set('')
  scheduleCheck()
  scheduleSave()
}

function newTab() {
  tabs.set(tabs().map(tab => tab.id === activeTab() ? { ...tab, code: code() } : tab))
  const id = `t${Date.now().toString(36)}${++tabCounter}`
  tabs.set([...tabs(), { id, title: 'Untitled', code: '' }])
  activeTab.set(id)
  code.set('')
  widgets.set([])
  diagnostics.set([])
  scheduleSave()
}

function closeTab(id) {
  if (tabs().length === 1) {
    code.set('')
    tabs.set([{ ...tabs()[0], code: '' }])
    scheduleSave()
    return
  }
  const index = tabs().findIndex(tab => tab.id === id)
  const remaining = tabs().filter(tab => tab.id !== id)
  tabs.set(remaining)
  if (id === activeTab()) {
    const next = remaining[Math.max(0, index - 1)]
    activeTab.set(next.id)
    code.set(next.code)
    scheduleCheck()
  }
  scheduleSave()
}

// One preference changed here: kept by the agent, and told to the app's other windows.
async function setUi(name, value) {
  ui.set({ ...ui(), [name]: value })
  const response = await fetch('/__tinkerbelle/preferences', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ [name]: value }) })
  if (!response.ok) return
  ui.set(await response.json())
  announcePreferences(ui())
}

async function loadPreferences() {
  const response = await fetch('/__tinkerbelle/preferences')
  if (response.ok) ui.set(await response.json())
}

async function loadWorkspace() {
  const response = await fetch('/__tinkerbelle/workspace')
  if (!response.ok) return
  const body = await response.json()
  if (Array.isArray(body.tabs) && body.tabs.length) {
    tabs.set(body.tabs)
    const active = body.tabs.find(tab => tab.id === body.active) || body.tabs[0]
    activeTab.set(active.id)
    code.set(active.code)
  }
}

const connectOpen = state(false)
const connectKind = state('ssh')
const form = state({ host: '', user: '', port: '', identityFile: '', jump: '', directory: '', envFile: '.env', container: '', pod: '', namespace: '', context: '' })
const found = state([])
const finding = state(false)
const confirming = state('')

const isProduction = derived(() => /prod|live/i.test((connection() && connection().environment) || ''))
const environmentLabel = derived(() => (connection() && connection().environment) || '')
const whereLabel = derived(() => (connection() && connection().where) || '')
const connected = derived(() => connection() !== null)
const dotClass = derived(() => !connected() ? 'tb-dot-off' : isProduction() ? 'tb-dot-danger' : 'tb-dot-ok')
const problems = derived(() => diagnostics().filter(item => item.severity !== 'info' && item.severity !== 'hint').length)
const recentProjects = derived(() => recent().filter(item => item.kind === 'local' || (item.spec && item.kind !== 'sandbox')).slice(0, 6))

function focusEditor() {
  const editor = editorRef.value && editorRef.value.__stx_exposed
  if (editor) editor.focus()
}

function togglePane() {
  paneOpen.set(!paneOpen())
  if (!paneOpen()) { stopLogs(); focusEditor() }
}

function closeSwitcher() {
  switcherOpen.set(false)
  focusEditor()
}

async function openRecent(item) {
  switcherOpen.set(false)
  if (item.kind === 'local') {
    projectPath.set(item.path)
    await connect({ kind: 'local', path: item.path })
  }
  else {
    await connect(item.spec)
  }
}

async function openSandbox() {
  switcherOpen.set(false)
  await connect({ kind: 'sandbox' })
}

function openRemote() {
  switcherOpen.set(false)
  connectOpen.set(true)
}
const targetLabel = derived(() => connection() ? connection().label : 'Not connected')

let firstState = true

async function loadState() {
  const response = await fetch('/__tinkerbelle/state')
  if (!response.ok) return
  const body = await response.json()
  const first = firstState
  firstState = false
  // With nothing open, the window connects to what Settings says it should: the sandbox unless told otherwise,
  // so the editor can run something the moment it is up.
  if (first && !body.connection) {
    const last = (body.recent || []).find(item => item.kind === 'local' || (item.spec && item.kind !== 'sandbox'))
    if (ui().startup === 'last' && last) void connect(last.kind === 'local' ? { kind: 'local', path: last.path } : last.spec)
    else if (ui().startup !== 'nothing') void connect({ kind: 'sandbox' })
  }
  connection.set(body.connection)
  recent.set(body.recent || [])
  if (body.note && !notice()) notice.set(body.note)
  if (body.connection && body.connection.path && !projectPath()) projectPath.set(body.connection.kind === 'local' ? body.connection.path : '')
}

function firstLine(text) {
  const line = (text || '').split('\n').find(part => part.trim()) || ''
  return line.length > 90 ? `${line.slice(0, 90)}...` : line
}

// Everything the palette can do, as one list: actions, then projects, snippets and what was run.
const paletteItems = derived(() => {
  const items = [
    { kind: 'action', id: 'run', title: 'Run', hint: `${MOD}+Enter` },
    { kind: 'action', id: 'settings', title: 'Settings', hint: `${MOD}+,` },
    { kind: 'action', id: 'open', title: 'Open a project', hint: `${MOD}+O` },
    { kind: 'action', id: 'sandbox', title: 'Open the sandbox', hint: '' },
    { kind: 'action', id: 'remote', title: 'Connect to a server, container or pod', hint: '' },
    { kind: 'action', id: 'pane', title: 'Show or hide the side pane', hint: `${MOD}+J` },
    { kind: 'action', id: 'result', title: 'Show the result', hint: '' },
    { kind: 'action', id: 'logs', title: 'Follow the log', hint: '' },
    { kind: 'action', id: 'info', title: 'About this connection', hint: '' },
    { kind: 'action', id: 'assistant', title: 'Ask the assistant', hint: '' },
    { kind: 'action', id: 'mcp', title: 'Let AI tools use TinkerBelle (MCP)', hint: mcp().enabled ? 'on' : 'off' },
    { kind: 'action', id: 'update', title: updateInstalled() ? 'Restart to finish updating' : updateReady() ? `Install TinkerBelle ${update().version}` : 'Check for updates', hint: update().currentVersion || license().version || '' },
    { kind: 'action', id: 'license', title: 'License', hint: license().source === 'license' ? 'Pro' : license().source === 'beta' ? 'beta' : 'free' },
    { kind: 'action', id: 'new-tab', title: 'New buffer', hint: '' },
    { kind: 'action', id: 'theme-system', title: 'Theme: follow the system', hint: ui().theme === 'system' ? 'current' : '' },
    { kind: 'action', id: 'theme-light', title: 'Theme: light', hint: ui().theme === 'light' ? 'current' : '' },
    { kind: 'action', id: 'theme-dark', title: 'Theme: dark', hint: ui().theme === 'dark' ? 'current' : '' },
    { kind: 'action', id: 'font-up', title: 'Larger code', hint: `${ui().fontSize}px` },
    { kind: 'action', id: 'font-down', title: 'Smaller code', hint: `${ui().fontSize}px` },
    { kind: 'action', id: 'ai-settings', title: 'AI settings', hint: ai().enabled ? ai().provider : 'off' },
    { kind: 'action', id: 'suggest', title: 'Suggest at the cursor', hint: 'Alt+Backslash' },
    { kind: 'action', id: 'save', title: 'Save as snippet', hint: firstLine(code()) },
    { kind: 'action', id: 'clear-history', title: 'Clear history for this connection', hint: '' },
  ]
  for (const item of recent()) {
    if (item.kind === 'local') items.push({ kind: 'project', id: item.key, title: `Open ${item.label}`, hint: item.path, path: item.path })
    else if (item.spec && item.kind !== 'sandbox') items.push({ kind: item.kind, id: item.key, title: `Open ${item.label}`, hint: item.where || '', spec: item.spec })
  }
  for (const item of snippets()) items.push({ kind: 'snippet', id: `s${item.id}`, title: item.title, hint: firstLine(item.code), code: item.code })
  for (const item of historyEntries()) items.push({ kind: 'history', id: `h${item.id}`, title: firstLine(item.code), hint: item.ok ? '' : 'failed', code: item.code })
  return fuzzyFilter(paletteQuery(), items, item => `${item.title} ${item.hint || ''}`).slice(0, 80)
})

async function openPalette() {
  paletteQuery.set('')
  paletteActive.set(0)
  paletteOpen.set(true)
  await nextTick()
  if (paletteInput.value) paletteInput.value.focus()
  const [snippetsResponse, historyResponse] = await Promise.all([fetch('/__tinkerbelle/snippets'), fetch('/__tinkerbelle/history')])
  if (snippetsResponse.ok) snippets.set((await snippetsResponse.json()).snippets || [])
  if (historyResponse.ok) historyEntries.set((await historyResponse.json()).entries || [])
  await loadState()
}

function closePalette() {
  paletteOpen.set(false)
  const editor = editorRef.value && editorRef.value.__stx_exposed
  if (editor) editor.focus()
}

async function choose(item) {
  if (!item) return
  closePalette()
  if (item.kind === 'snippet' || item.kind === 'history') {
    code.set(item.code)
    scheduleCheck()
  }
  else if (item.kind === 'project') {
    projectPath.set(item.path)
    await connect({ kind: 'local', path: item.path })
  }
  else if (item.spec) {
    await connect(item.spec)
  }
  else if (item.id === 'remote') {
    connectOpen.set(true)
  }
  else if (item.id === 'assistant' || item.id === 'logs' || item.id === 'info' || item.id === 'result') {
    showView(item.id)
  }
  else if (item.id === 'pane') {
    togglePane()
  }
  else if (item.id === 'settings') {
    await openSettingsWindow()
  }
  else if (item.id === 'open') {
    switcherOpen.set(true)
  }
  else if (item.id === 'ai-settings') {
    await openSettingsWindow('ai')
  }
  else if (item.id === 'license') {
    await openSettingsWindow('license')
  }
  else if (item.id === 'update') {
    if (updateInstalled()) await restartForUpdate()
    else if (updateReady()) await installUpdate()
    else await checkForUpdate()
  }
  else if (item.id === 'new-tab') {
    newTab()
  }
  else if (item.id.startsWith('theme-')) {
    setUi('theme', item.id.slice(6))
  }
  else if (item.id === 'font-up' || item.id === 'font-down') {
    setUi('fontSize', Math.min(22, Math.max(10, ui().fontSize + (item.id === 'font-up' ? 1 : -1))))
  }
  else if (item.id === 'mcp') {
    await openSettingsWindow('tools')
  }
  else if (item.id === 'suggest') {
    await suggest()
  }
  else if (item.id === 'run') {
    runAll()
  }
  else if (item.id === 'sandbox') {
    await connect({ kind: 'sandbox' })
  }
  else if (item.id === 'save') {
    await fetch('/__tinkerbelle/snippets', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ title: firstLine(code()) || 'Untitled', code: code(), scoped: connection() && connection().kind === 'local' }),
    })
    notice.set('Saved as a snippet.')
  }
  else if (item.id === 'clear-history') {
    await fetch('/__tinkerbelle/history', { method: 'DELETE' })
    notice.set('History cleared.')
  }
}

function paletteKey(event) {
  const count = paletteItems().length
  if (event.key === 'ArrowDown') { event.preventDefault(); paletteActive.set(count ? (paletteActive() + 1) % count : 0) }
  else if (event.key === 'ArrowUp') { event.preventDefault(); paletteActive.set(count ? (paletteActive() - 1 + count) % count : 0) }
  else if (event.key === 'Enter') { event.preventDefault(); void choose(paletteItems()[paletteActive()]) }
  else if (event.key === 'Escape') { event.preventDefault(); closePalette() }
}

function appKey(event) {
  if (event.altKey && event.code === 'Backslash') {
    event.preventDefault()
    void suggest()
    return
  }
  if (event.key === 'Escape' && switcherOpen()) {
    event.preventDefault()
    closeSwitcher()
    return
  }
  if (!(event.metaKey || event.ctrlKey)) return
  const key = event.key.toLowerCase()
  if (key === ',') {
    event.preventDefault()
    void openSettingsWindow()
  }
  else if (key === 'k') {
    event.preventDefault()
    if (paletteOpen()) closePalette()
    else void openPalette()
  }
  else if (key === 'j') {
    event.preventDefault()
    togglePane()
  }
  else if (key === 'o') {
    event.preventDefault()
    switcherOpen.set(!switcherOpen())
  }
  else if (key === 't') {
    event.preventDefault()
    newTab()
  }
}

async function connect(target) {
  connecting.set(true)
  notice.set('')
  try {
    const response = await fetch('/__tinkerbelle/connect', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(target),
    })
    const body = await response.json()
    if (!response.ok) throw new Error(body.error || 'Could not connect.')
    connection.set(body.connection)
    modelList.set(null)
    scheduleCheck()
    const warnings = body.session?.warnings || []
    notice.set(warnings.length ? warnings.join(' ') : '')
  }
  catch (cause) {
    notice.set(cause instanceof Error ? cause.message : 'Could not connect.')
  }
  finally {
    connecting.set(false)
  }
}

function setField(name, value) {
  form.set({ ...form(), [name]: value })
}

function sshPart() {
  const f = form()
  if (!f.host.trim()) return undefined
  return {
    host: f.host.trim(),
    ...(f.user.trim() ? { user: f.user.trim() } : {}),
    ...(f.port.trim() ? { port: Number(f.port) } : {}),
    ...(f.identityFile.trim() ? { identityFile: f.identityFile.trim() } : {}),
    ...(f.jump.trim() ? { jump: f.jump.trim() } : {}),
  }
}

function remoteTarget() {
  const f = form()
  const project = { directory: f.directory.trim(), ...(f.envFile.trim() ? { envFile: f.envFile.trim() } : {}) }
  const pod = f.pod.trim()
    ? { pod: f.pod.trim(), ...(f.namespace.trim() ? { namespace: f.namespace.trim() } : {}), ...(f.context.trim() ? { context: f.context.trim() } : {}), ...(f.container.trim() ? { container: f.container.trim() } : {}) }
    : undefined
  if (connectKind() === 'ssh') {
    return { kind: 'ssh', ...sshPart(), ...project, ...(pod ? { pod } : f.container.trim() ? { container: f.container.trim() } : {}) }
  }
  if (connectKind() === 'docker') return { kind: 'docker', container: f.container.trim(), ...project }
  return { kind: 'kube', ...pod, ...project }
}

// List what is running on the target, so a container or a pod is picked, not typed.
async function discover(what) {
  finding.set(true)
  found.set([])
  notice.set('')
  try {
    const f = form()
    const response = await fetch('/__tinkerbelle/discover', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ what, ssh: connectKind() === 'ssh' ? sshPart() : undefined, context: f.context.trim() || undefined, namespace: f.namespace.trim() || undefined }),
    })
    const body = await response.json()
    if (!response.ok) throw new Error(body.error || 'Nothing could be listed.')
    if (what === 'containers') found.set(body.containers.map(item => ({ field: 'container', value: item.name, hint: `${item.image} (${item.status})` })))
    else if (what === 'pods') found.set(body.pods.map(item => ({ field: 'pod', value: item.name, hint: item.phase })))
    else if (what === 'contexts') found.set(body.contexts.map(item => ({ field: 'context', value: item, hint: '' })))
    else if (what === 'namespaces') found.set(body.namespaces.map(item => ({ field: 'namespace', value: item, hint: '' })))
  }
  catch (cause) {
    notice.set(cause instanceof Error ? cause.message : 'Nothing could be listed.')
  }
  finally {
    finding.set(false)
  }
}

async function pick(item) {
  setField(item.field, item.value)
  found.set([])
  if (item.field !== 'container' || form().directory.trim()) return
  const response = await fetch('/__tinkerbelle/discover', {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ what: 'workdir', container: item.value, ssh: connectKind() === 'ssh' ? sshPart() : undefined }),
  })
  const body = await response.json().catch(() => ({}))
  if (body.workdir) setField('directory', body.workdir)
}

async function connectRemote() {
  await connect(remoteTarget())
  if (connected() && connection().kind !== 'sandbox' && connection().kind !== 'local') connectOpen.set(false)
}

function connectProject() {
  const path = projectPath().trim()
  if (!path) return
  switcherOpen.set(false)
  void connect({ kind: 'local', path })
}

function take(frame) {
  // Colour codes are for a terminal. Here they are noise.
  if (frame.type === 'stdout' || frame.type === 'stderr' || frame.type === 'stray') output.set(output() + frame.text.replace(/\u001B\[[0-9;]*[A-Za-z]/g, ''))
  else if (frame.type === 'dump') output.set(`${output()}${renderTinkerValue(frame.value)}\n`)
  else if (frame.type === 'query') queries.set([...queries(), frame])
  else if (frame.type === 'probe') {
    const text = frame.kind === 'time' ? `${frame.ms} ms` : renderTinkerValue(frame.value).replace(/\s*\n\s*/g, ' ')
    widgets.set([...widgets(), { line: frame.line, text: text.length > 120 ? `${text.slice(0, 120)}...` : text, kind: frame.kind === 'time' ? 'info' : 'result' }])
  }
  else if (frame.type === 'result') {
    result.set(renderTinkerValue(frame.value))
    duration.set(`${frame.durationMs} ms`)
    lastValue.set(frame.value)
    // Open on the view that suits the value: a page for markup, a table for a list of records.
    resultView.set(frame.value.t === 'html' ? 'preview' : gridOf(frame.value) ? 'table' : SCALARS.includes(frame.value.t) ? 'text' : 'tree')
  }
  else if (frame.type === 'error') { failure.set(renderTinkerValue(frame.error)); duration.set(`${frame.durationMs} ms`) }
  else if (frame.type === 'agent-error') failure.set(frame.message)
}

async function run(source) {
  if (running() || !connected()) return
  running.set(true)
  view.set('result')
  if (ui().openPaneOnRun) paneOpen.set(true)
  stopLogs()
  output.set('')
  result.set('')
  failure.set('')
  duration.set('')
  queries.set([])
  widgets.set([])
  lastValue.set(null)
  try {
    const response = await fetch('/__tinkerbelle/run', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ code: source }),
    })
    if (!response.ok || !response.body) {
      const body = await response.json().catch(() => ({}))
      throw new Error(body.error || 'The run could not start.')
    }
    const reader = response.body.getReader()
    const decoder = new TextDecoder()
    let pending = ''
    for (;;) {
      const { value, done } = await reader.read()
      if (done) break
      pending += decoder.decode(value, { stream: true })
      const lines = pending.split('\n')
      pending = lines.pop() || ''
      for (const line of lines) if (line) take(JSON.parse(line))
    }
  }
  catch (cause) {
    failure.set(cause instanceof Error ? cause.message : 'The run failed.')
  }
  finally {
    running.set(false)
  }
}

async function language(op, text, line, column) {
  const response = await fetch('/__tinkerbelle/language', {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ op, text, line, column }),
  })
  return response.ok ? response.json() : {}
}

// Completions come from the project's own TypeScript server, so a model's
// columns and an action's parameters are what is offered.
async function complete(detail) {
  if (!connected() || !detail) return
  const body = await language('complete', code(), detail.line, detail.column)
  // A ref on a component is its element; what the component exposes hangs off it.
  const editor = editorRef.value && editorRef.value.__stx_exposed
  if (!editor || !body.items) return
  const query = (detail.query || '').toLowerCase()
  const items = body.items
    .filter(item => !query || item.label.toLowerCase().startsWith(query))
    .slice(0, 60)
    .map(item => ({ label: item.label, kind: item.kind, detail: item.detail, insert: item.insert }))
  if (items.length) editor.showCompletions(items, { from: detail.from })
}

// What a word is: asked for when the pointer rests on it, or with Cmd/Ctrl+I at the caret.
async function onHover(request) {
  if (!connected() || !request) return
  const body = await language('hover', code(), request.line, request.column)
  const editor = editorRef.value && editorRef.value.__stx_exposed
  if (editor && editor.showHover && body.hover) editor.showHover(request.explicit ? body.hover : trimHover(body.hover), { line: request.line, column: request.column })
}

// The call being typed: its parameters, and which one the caret is on.
async function onSignature(request) {
  if (!connected() || !request) return
  const body = await language('signature', code(), request.line, request.column)
  const editor = editorRef.value && editorRef.value.__stx_exposed
  if (editor && editor.showSignature) editor.showSignature(body.signature || null)
}

function scheduleCheck() {
  clearTimeout(checkTimer)
  if (!connected()) return
  checkTimer = setTimeout(async () => {
    const serial = ++checkSerial
    const body = await language('diagnostics', code(), 0, 0)
    if (serial === checkSerial) diagnostics.set(body.diagnostics || [])
  }, 350)
}

// On production a run is asked for twice: once to say what it will touch, once to do it.
function guarded(source) {
  if (!isProduction() || confirming() === source) {
    confirming.set('')
    void run(source)
    return
  }
  confirming.set(source)
}

function runAll(detail) {
  guarded(detail && typeof detail.value === 'string' ? detail.value : code())
}

function runSelection(detail) {
  if (detail && detail.text) guarded(detail.text)
}

// App-wide shortcuts work wherever the focus is, including before anything has been clicked.
useEventListener('keydown', appKey)
// Coming back to the window picks up what changed while it was away: a project opened by `tinkerbelle <path>`, for one.
useEventListener('focus', () => { void loadState(); void loadUpdate(); void loadPreferences() })
// Settings is its own window: what it changes is applied here as it changes.
onPreferences((changed) => {
  if (!changed || typeof changed !== 'object') return
  // Not a preference: the AI settings, the MCP switch or the license changed in Settings.
  if (changed.changed) { void loadAi(); void loadMcp(); void loadLicense(); void loadUpdate() }
  else ui.set({ ...ui(), ...changed })
})
onSettingsRequested(() => { void openSettingsWindow() })
// The bar stands in for the title bar: pressing an empty part of it moves the window.
dragWindowFrom('[data-window-drag]')

// Preferences first: what the window connects to at launch is one of them.
void loadPreferences().then(loadState)
void loadAi()
void loadMcp()
void loadWorkspace()
void loadLicense()
void loadUpdate()
</script>

@nolayout
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>TinkerBelle</title>
    <style>
      /*
       * One palette, two values each. Every colour in the window is one of these roles: nothing
       * below names a grey of its own, so light and dark cannot drift apart. The window is one
       * surface, like a terminal (bar, code and status line share a background, parted by
       * hairlines); the side pane sits a step back from it, and anything that floats or takes
       * typing sits a step forward.
       */
      [data-tinkerbelle-theme] {
        color-scheme: light;
        --tb-bg: #fbfbfa; --tb-raised: #f3f3f1; --tb-surface: #ffffff; --tb-fill: rgb(0 0 0 / 0.055);
        --tb-line: rgb(0 0 0 / 0.1); --tb-line-strong: rgb(0 0 0 / 0.24); --tb-hover: rgb(0 0 0 / 0.05);
        --tb-fg: #1f2328; --tb-fg-2: #59606b; --tb-muted: #8a909b;
        --tb-primary: #1f2328; --tb-primary-fg: #ffffff;
        --tb-danger: #c2283c; --tb-danger-bg: rgb(194 40 60 / 0.07); --tb-danger-line: rgb(194 40 60 / 0.28); --tb-danger-solid: #c2283c;
        --tb-warn: #8f5f00; --tb-ok: #1f9d57; --tb-info: #0b6bcb; --tb-off: #c4c7cc;
        --tb-scrim: rgb(20 22 26 / 0.28); --tb-shadow: 0 16px 48px -16px rgb(0 0 0 / 0.28), 0 2px 6px -2px rgb(0 0 0 / 0.1);
        --tb-selection: rgb(185 125 13 / 0.22);
        --stx-accent: #9a6700;
      }
      [data-tinkerbelle-theme].dark {
        color-scheme: dark;
        --tb-bg: #23262c; --tb-raised: #1e2126; --tb-surface: #2c3038; --tb-fill: rgb(255 255 255 / 0.075);
        --tb-line: rgb(255 255 255 / 0.09); --tb-line-strong: rgb(255 255 255 / 0.26); --tb-hover: rgb(255 255 255 / 0.065);
        --tb-fg: #dcdfe4; --tb-fg-2: #a4aab5; --tb-muted: #7b828e;
        --tb-primary: #e4e6ea; --tb-primary-fg: #1b1d21;
        --tb-danger: #f08592; --tb-danger-bg: rgb(240 133 146 / 0.12); --tb-danger-line: rgb(240 133 146 / 0.32); --tb-danger-solid: #cf3d52;
        --tb-warn: #e3b341; --tb-ok: #3fb97a; --tb-info: #6cb6ff; --tb-off: #555b66;
        --tb-scrim: rgb(0 0 0 / 0.5); --tb-shadow: 0 18px 52px -14px rgb(0 0 0 / 0.7), 0 0 0 1px rgb(255 255 255 / 0.06);
        --tb-selection: rgb(224 165 38 / 0.26);
        --stx-accent: #e0a526;
      }
      /*
       * The component library draws from role tokens; these are the same roles, so its tables, trees
       * and menus match the window. The selector is doubled because the library sets its own values
       * on `.dark`, the class this same element carries, and would otherwise win in the dark.
       */
      [data-tinkerbelle-theme][data-tinkerbelle-theme] {
        --stx-page: var(--tb-bg); --stx-content: var(--tb-bg);
        --stx-panel: var(--tb-surface); --stx-field: var(--tb-surface); --stx-field-hover: var(--tb-surface);
        --stx-surface: var(--tb-raised); --stx-surface-raised: var(--tb-surface); --stx-surface-sunken: var(--tb-fill);
        --stx-surface-hover: var(--tb-hover); --stx-surface-raised-hover: var(--tb-hover); --stx-surface-sunken-hover: var(--tb-hover);
        --stx-fg: var(--tb-fg); --stx-fg-strong: var(--tb-fg); --stx-fg-soft: var(--tb-fg-2); --stx-fg-muted: var(--tb-fg-2); --stx-fg-subtle: var(--tb-muted);
        --stx-line: var(--tb-line); --stx-line-strong: var(--tb-line-strong); --stx-line-hover: var(--tb-line-strong);
        --stx-inverse: var(--tb-primary); --stx-inverse-ink: var(--tb-primary-fg);
        --stx-link: var(--stx-accent); --stx-link-hover: var(--stx-accent);
        --stx-danger: var(--tb-danger); --stx-danger-fg: var(--tb-danger); --stx-danger-line: var(--tb-danger-line);
        --stx-warning: var(--tb-warn); --stx-success: var(--tb-ok); --stx-info: var(--tb-info);
      }
      /* Before the page has read the preference, the window is the system's colour and not a flash of the other one. */
      html, body { background: #fbfbfa; }
      @media (prefers-color-scheme: dark) { html, body { background: #23262c; } }
      body { font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI Variable', 'Segoe UI', system-ui, sans-serif; }
      [data-tinkerbelle-theme] ::selection { background: var(--tb-selection); }

      /* The roles as classes, for the markup. */
      .tb-surface { background-color: var(--tb-surface); }
      .tb-fill { background-color: var(--tb-fill); }
      .tb-line { border-color: var(--tb-line); }
      .tb-divide > * + * { border-color: var(--tb-line); }
      .tb-fg { color: var(--tb-fg); }
      .tb-fg-2 { color: var(--tb-fg-2); }
      .tb-fg-3 { color: var(--tb-muted); }
      .tb-hover:hover { background-color: var(--tb-hover); }
      .tb-hover-fg:hover { color: var(--tb-fg); }
      .tb-focus:focus { border-color: var(--tb-line-strong); outline: none; }
      .tb-focus:focus-visible { box-shadow: 0 0 0 3px color-mix(in srgb, var(--stx-accent) 28%, transparent); }
      .tb-primary { background-color: var(--tb-primary); color: var(--tb-primary-fg); }
      .tb-primary:hover:not(:disabled) { background-color: color-mix(in srgb, var(--tb-primary) 88%, var(--tb-bg)); }
      .tb-danger-fg { color: var(--tb-danger); }
      .tb-warn-fg { color: var(--tb-warn); }
      .tb-danger-bg { background-color: var(--tb-danger-bg); }
      .tb-danger-line { border-color: var(--tb-danger-line); }
      .tb-danger-solid { background-color: var(--tb-danger-solid); color: #ffffff; }
      .tb-scrim { background-color: var(--tb-scrim); }
      .tb-dot-ok { background-color: var(--tb-ok); }
      .tb-dot-warn { background-color: var(--tb-warn); }
      .tb-dot-info { background-color: var(--tb-info); }
      .tb-dot-danger { background-color: var(--tb-danger-solid); }
      .tb-dot-off { background-color: var(--tb-off); }
      [data-tinkerbelle-theme] :focus-visible { outline: 2px solid color-mix(in srgb, var(--stx-accent) 70%, transparent); outline-offset: 1px; }
      [data-tinkerbelle-theme] input::placeholder, [data-tinkerbelle-theme] textarea::placeholder { color: var(--tb-muted); }
      .tb-window { background: var(--tb-bg); color: var(--tb-fg); }

      /*
       * The bar is the window's title bar: there is no other. It leaves room for the window buttons,
       * which the shell measures and publishes, and every part of it that is not a control drags the window.
       */
      .tb-bar {
        height: max(38px, calc(var(--craft-window-controls-inset-y, 0px) * 2 + var(--craft-window-controls-height, 0px)));
        padding: 0 8px 0 calc(var(--craft-window-controls-inset-x, 0px) + var(--craft-window-controls-width, 0px) + 10px);
        border-bottom: 1px solid var(--tb-line);
        user-select: none; -webkit-user-select: none;
      }
      .tb-run {
        height: 24px; padding: 0 9px 0 7px; border: 1px solid var(--tb-line); border-radius: 6px;
        color: var(--tb-fg); font-size: 12px; font-weight: 500;
      }
      .tb-run:hover { background: var(--tb-hover); }
      .tb-run:disabled { opacity: 0.4; }

      .tb-status { height: 26px; padding: 0 6px; border-top: 1px solid var(--tb-line); color: var(--tb-muted); font-size: 11px; }
      .tb-icon { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 20px; border-radius: 4px; color: var(--tb-muted); }
      .tb-icon:hover, .tb-status-action:hover { background: var(--tb-hover); color: var(--tb-fg); }
      .tb-icon-on { color: var(--tb-fg); background: var(--tb-hover); }
      .tb-status-action { padding: 0 6px; height: 20px; border-radius: 4px; color: var(--tb-fg); }
      .tb-problems { color: var(--tb-danger); }

      /* The editor is the window: no frame of its own, and the window's background behind the code. */
      [data-tinkerbelle-editor] [data-stx-code-editor] {
        border: 0; border-radius: 0; --stx-code-bg: transparent; --stx-code-fg: var(--tb-fg);
        --stx-code-gutter-fg: color-mix(in srgb, var(--tb-muted) 70%, transparent); --stx-code-gutter-active-fg: var(--tb-fg);
        --stx-code-active-line: var(--tb-hover);
        --stx-code-padding-y: 12px; --stx-code-padding-x: 14px;
        --stx-code-font: var(--tb-code-font, 'Zed Mono', 'JetBrains Mono', 'SF Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
        --stx-code-font-size: var(--tb-code-size, 13px); --stx-code-line-height: var(--tb-code-line, 22px);
      }
      .tinkerbelle-pane { width: 44%; min-width: 320px; max-width: 760px; background: var(--tb-raised); border-left: 1px solid var(--tb-line); }
      .tinkerbelle-float { box-shadow: var(--tb-shadow); }
    </style>
  </head>
  <body class="overflow-hidden h-screen antialiased">
    <div :class="themeClass()" data-tinkerbelle-theme>
    <div class="flex flex-col h-screen tb-window" data-tinkerbelle-app>
      <header class="flex gap-1 items-center shrink-0 tb-bar" data-window-drag data-tinkerbelle-bar>
        <div class="relative shrink-0">
          <button type="button" class="flex gap-2 items-center px-2 h-7 text-[13px] rounded-md tb-hover" aria-haspopup="dialog" :aria-expanded="switcherOpen() ? 'true' : 'false'" :title="'Open a project (' + MOD + '+O)'" @click="switcherOpen.set(!switcherOpen())" data-tinkerbelle-switch>
            <span :class="dotClass()" class="h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
            <span class="font-medium" data-tinkerbelle-target>{{ connecting() ? 'Connecting' : targetLabel() }}</span>
            @if(environmentLabel())
              <span :class="isProduction() ? 'font-medium text-[11px] tb-danger-fg ' : 'text-[11px] tb-fg-3'" data-tinkerbelle-environment>{{ environmentLabel() }}</span>
            @endif
            <span class="inline-block h-3.5 w-3.5 i-hugeicons-arrow-down-01 tb-fg-3" aria-hidden="true"></span>
          </button>

          @if(switcherOpen())
            <div class="fixed inset-0 z-40" @click="closeSwitcher()" aria-hidden="true"></div>
            <div class="absolute left-0 top-9 z-50 w-80 border rounded-lg tb-line tb-surface tinkerbelle-float" role="dialog" aria-label="Open a project" data-tinkerbelle-switcher>
              <label class="flex gap-2 items-center px-3 h-10 border-b tb-line">
                <span class="inline-block shrink-0 h-4 w-4 i-hugeicons-folder-01 tb-fg-3" aria-hidden="true"></span>
                <input
                  type="text"
                  :value="projectPath()"
                  @input="projectPath.set($event.target.value)"
                  @keydown.enter="connectProject()"
                  placeholder="Path to a project, then Enter"
                  aria-label="Project path"
                  autocomplete="off"
                  spellcheck="false"
                  autofocus
                  class="flex-1 min-w-0 font-mono text-xs bg-transparent focus:outline-none"
                  data-tinkerbelle-path
                >
              </label>
              <ul class="py-1 text-[13px]">
                <li><button type="button" class="flex gap-2.5 items-center px-3 h-8 w-full text-left tb-hover" @click="openSandbox()" data-tinkerbelle-sandbox><span class="inline-block h-4 w-4 i-hugeicons-cube tb-fg-3" aria-hidden="true"></span>Sandbox<span class="ml-auto text-[11px] tb-fg-3">no project</span></button></li>
                @foreach(recentProjects() as item)
                  <li><button type="button" class="flex gap-2.5 items-center px-3 h-8 w-full text-left tb-hover" @click="openRecent(item)"><span :class="item.kind === 'local' ? 'i-hugeicons-folder-01' : 'i-hugeicons-cloud-server'" class="inline-block shrink-0 h-4 w-4 tb-fg-3" aria-hidden="true"></span><span class="shrink-0">{{ item.label }}</span><span class="ml-auto min-w-0 font-mono text-[11px] truncate tb-fg-3">{{ item.path || item.where || '' }}</span></button></li>
                @endforeach
              </ul>
              <div class="py-1 text-[13px] border-t tb-line">
                <button type="button" class="flex gap-2.5 items-center px-3 h-8 w-full text-left tb-hover" @click="openRemote()" data-tinkerbelle-remote><span class="inline-block h-4 w-4 i-hugeicons-server-stack-01 tb-fg-3" aria-hidden="true"></span>Server, container or pod</button>
              </div>
            </div>
          @endif
        </div>

        <div class="flex overflow-x-auto flex-1 gap-0.5 items-center px-1 min-w-0" role="tablist" aria-label="Buffers" data-tinkerbelle-tabs>
          @foreach(tabs() as tab)
            <span :class="tab.id === activeTab() ? 'flex items-center shrink-0 pl-2.5 pr-1 h-7 text-[12px] tb-fg tb-fill rounded-md' : 'flex items-center shrink-0 px-2.5 h-7 text-[12px] tb-fg-2 tb-hover-fg rounded-md'">
              <button type="button" role="tab" :aria-selected="tab.id === activeTab() ? 'true' : 'false'" class="max-w-[14rem] font-mono truncate" @click="selectTab(tab.id)">{{ tab.id === activeTab() ? tabTitle({ code: code() }) : tabTitle(tab) }}</button>
              @if(tab.id === activeTab() && tabs().length > 1)
                <button type="button" class="flex items-center justify-center ml-1 h-5 w-5 rounded tb-fg-3 tb-hover-fg" :aria-label="'Close ' + tabTitle(tab)" @click="closeTab(tab.id)"><span class="inline-block h-3 w-3 i-hugeicons-cancel-01" aria-hidden="true"></span></button>
              @endif
            </span>
          @endforeach
          <button type="button" class="flex items-center justify-center shrink-0 h-7 w-7 rounded-md tb-fg-2 tb-hover tb-hover-fg" aria-label="New buffer" :title="'New buffer (' + MOD + '+T)'" @click="newTab()" data-tinkerbelle-new-tab><span class="inline-block h-3.5 w-3.5 i-hugeicons-add-01" aria-hidden="true"></span></button>
        </div>

        <button type="button" class="flex gap-1.5 items-center shrink-0 tb-run" :disabled="running() || !connected()" :title="'Run (' + MOD + '+Enter)'" @click="runAll()" data-tinkerbelle-run><span :class="running() ? 'i-hugeicons-stop' : 'i-hugeicons-play'" class="inline-block h-3.5 w-3.5" aria-hidden="true"></span>{{ running() ? 'Running' : 'Run' }}</button>
      </header>

      @if(notice())
        <p class="flex gap-2 items-center px-3 py-1.5 text-[12px] border-b tb-fg-2 tb-line" role="status" data-tinkerbelle-notice><span class="shrink-0 h-1.5 w-1.5 rounded-full tb-dot-warn" aria-hidden="true"></span><span class="flex-1 min-w-0">{{ notice() }}</span><button type="button" class="shrink-0 tb-fg-3 tb-hover-fg" aria-label="Dismiss" @click="notice.set('')"><span class="inline-block h-3 w-3 i-hugeicons-cancel-01" aria-hidden="true"></span></button></p>
      @endif

      @if(confirming())
        <div class="flex gap-3 items-center px-3 py-2 text-xs border-b tb-danger-bg tb-danger-fg tb-danger-line" role="alert" data-tinkerbelle-confirm>
          <span class="flex-1">This will run on <strong>{{ environmentLabel() }}</strong> at {{ whereLabel() || targetLabel() }}. Anything it writes is written for real.</span>
          <button type="button" class="px-2.5 h-6 text-xs border rounded tb-danger-line tb-surface" @click="confirming.set('')">Cancel</button>
          <button type="button" class="px-2.5 h-6 font-medium text-xs rounded tb-danger-solid" @click="guarded(confirming())" data-tinkerbelle-confirm-run>Run on {{ environmentLabel() }}</button>
        </div>
      @endif

      <main class="flex flex-1 min-h-0">
        <section class="flex-1 min-h-0 min-w-0" aria-label="Code" :style="editorStyle()" data-tinkerbelle-editor>
          <CodeEditor
            language="typescript"
            height="100%"
            :theme="editorTheme()"
            label="Code to run"
            v-model:value="code"
            @ref="editorRef"
            :diagnostics="diagnostics()"
            :widgets="widgets()"
            :autoComplete="ui().completions"
            :hover="ui().hover"
            :signatureHelp="ui().signatureHelp"
            :tabSize="ui().tabSize"
            :insertSpaces="ui().indentWith !== 'tabs'"
            :inlineDiagnostics="ui().inlineProblems"
            :lineNumbers="ui().lineNumbers"
            :ghostText="ghost()"
            @selection="onSelection($event)"
            @input="scheduleCheck(); scheduleSuggest(); scheduleSave()"
            @complete="complete($event)"
            @hover="onHover($event)"
            @signature="onSignature($event)"
            @run="runAll($event)"
            @run-selection="runSelection($event)"
          />
        </section>

        <aside :class="paneOpen() ? 'flex flex-col shrink-0 min-h-0 tinkerbelle-pane' : 'hidden'" aria-label="Result, log, assistant and connection" data-tinkerbelle-pane>
          <div class="flex gap-0.5 items-center shrink-0 px-2 h-9 border-b tb-line" role="tablist">
            @foreach(PANE_VIEWS as item)
              <button type="button" role="tab" :aria-selected="view() === item.id ? 'true' : 'false'" :class="view() === item.id ? 'px-2 h-6 text-[12px] font-medium tb-fg ' : 'px-2 h-6 text-[12px] tb-fg-3 tb-hover-fg '" @click="showView(item.id)" :data-tinkerbelle-view="item.id">{{ item.title }}</button>
            @endforeach
            @if(view() === 'result' && duration())
              <span class="ml-auto pr-1 font-mono text-[11px] tb-fg-3">{{ duration() }}</span>
            @endif
            @if(view() === 'logs')
              <select :value="logLevel()" @change="logLevel.set($event.target.value)" aria-label="Lowest level to show" class="ml-auto px-1 h-6 text-[11px] bg-transparent rounded focus:outline-none tb-fg-2">
                <option value="all">All levels</option>
                <option value="info">Info and up</option>
                <option value="warning">Warnings and errors</option>
                <option value="error">Errors</option>
              </select>
              <input type="text" :value="logQuery()" @input="logQuery.set($event.target.value)" placeholder="Filter" aria-label="Filter log lines" class="px-2 h-6 w-28 text-[11px] rounded focus:outline-none tb-fill">
              <span :class="logFollowing() ? 'tb-dot-ok' : 'tb-dot-off '" class="h-1.5 w-1.5 rounded-full" :title="logFollowing() ? 'Following' : 'Stopped'" data-tinkerbelle-log-state></span>
            @endif
          </div>

          @if(view() === 'logs')
            <div class="overflow-y-auto flex-1 p-2 min-h-0 font-mono leading-5 text-[11px]" data-tinkerbelle-logs>
              @if(logNote())
                <p class="px-1 tb-danger-fg" role="alert">{{ logNote() }}</p>
              @endif
              @foreach(shownLogs() as line)
                <div :class="logClass(line.level)" class="flex gap-2 px-1"><span class="shrink-0 tb-fg-3">{{ line.time ? line.time.slice(11, 19) : '' }}</span><span class="shrink-0 w-12 uppercase">{{ line.level }}</span><span class="min-w-0 break-words whitespace-pre-wrap">{{ line.message }}</span></div>
              @endforeach
              @if(!logNote() && shownLogs().length === 0)
                <p class="px-1 tb-fg-2">{{ connected() ? 'No lines yet.' : 'Open a project to follow its log.' }}</p>
              @endif
            </div>
          @endif

          @if(view() === 'info')
            <div class="overflow-y-auto flex-1 p-3 space-y-3 min-h-0" data-tinkerbelle-info>
              @if(!connected())
                <p class="text-sm tb-fg-2">Open a project to see what it is running on.</p>
              @endif
              @if(panelsNote())
                <p class="text-xs tb-danger-fg" role="alert">{{ panelsNote() }}</p>
              @endif
              @foreach(panels() as panel)
                <article class="border rounded-lg tb-line tb-surface">
                  <h2 class="px-3 py-1.5 font-medium text-xs border-b tb-line">{{ panel.title }}</h2>
                  @foreach(panel.sections as section)
                    @if(section.title)
                      <h3 class="pt-2 px-3 text-[10px] tracking-wide uppercase tb-fg-3">{{ section.title }}</h3>
                    @endif
                    <dl class="px-3 py-1.5">
                      @foreach(section.rows as row)
                        <div class="flex gap-3 py-0.5 text-xs"><dt class="shrink-0 w-32 tb-fg-2">{{ row[0] }}</dt><dd class="min-w-0 break-words font-mono">{{ row[1] }}</dd></div>
                      @endforeach
                    </dl>
                  @endforeach
                </article>
              @endforeach
            </div>
          @endif

          @if(view() === 'assistant')
            <div class="flex flex-1 flex-col min-h-0" data-tinkerbelle-assistant>
              <div class="overflow-y-auto flex-1 p-3 space-y-3 min-h-0">
                @if(!ai().enabled || !ai().hasKey)
                  <div class="p-3 text-sm border rounded-lg tb-fg-2 tb-line tb-surface">
                    <p>The assistant uses your own API key. It is kept in this computer's keychain. Only your code, your question and the names of your models and columns are sent, never rows of data.</p>
                    <button type="button" class="mt-3 px-3 h-7 font-medium text-xs rounded-md tb-primary" @click="openSettingsWindow('ai')">Set up AI</button>
                  </div>
                @endif
                @foreach(chat() as message)
                  <div :class="message.role === 'user' ? 'ml-8 p-2.5 text-sm tb-fill rounded-lg' : 'mr-8 p-2.5 text-sm tb-surface border tb-line rounded-lg'">
                    <pre class="break-words font-sans whitespace-pre-wrap">{{ message.content }}</pre>
                    @if(message.code)
                      <button type="button" class="mt-2 px-2.5 h-6 text-xs border rounded tb-line" @click="useCode(message.code)">Put this code in the editor</button>
                    @endif
                  </div>
                @endforeach
                @if(asking())
                  <p class="text-xs tb-fg-2">Thinking</p>
                @endif
                @if(chatNote())
                  <p class="text-xs tb-danger-fg" role="alert">{{ chatNote() }}</p>
                @endif
              </div>
              <div class="flex gap-2 p-2 border-t tb-line">
                <input type="text" :value="question()" @input="question.set($event.target.value)" @keydown.enter="ask()" placeholder="Describe what you want the code to do" aria-label="Question for the assistant" class="flex-1 px-2.5 h-8 text-sm border rounded-md focus:outline-none tb-focus tb-line tb-surface">
                <button type="button" class="px-3 h-8 font-medium text-xs rounded-md disabled:opacity-40 tb-primary" :disabled="asking()" @click="ask()">Ask</button>
              </div>
            </div>
          @endif

          <div :class="view() === 'result' ? 'flex flex-col flex-1 min-h-0 overflow-y-auto' : 'hidden'" aria-live="polite">
          @if(!running() && !output() && !result() && !failure() && !queries().length)
            <p class="m-auto px-6 text-[13px] text-center tb-fg-3">Run with <span class="font-mono">{{ RUN_KEYS }}</span> to see the result here.</p>
          @endif

          @if(output())
            <article class="border-b tb-line" data-tinkerbelle-output>
              <h2 class="pt-2.5 px-3 text-[10px] tracking-wide uppercase tb-fg-3">Output</h2>
              <pre class="overflow-x-auto p-3 font-mono text-xs whitespace-pre-wrap">{{ output() }}</pre>
            </article>
          @endif

          @if(result())
            <article class="border-b tb-line" data-tinkerbelle-result>
              <h2 class="flex gap-1 items-center pt-2 px-3 text-[11px] tb-fg-2">
                @if(inspectable())
                  <button type="button" :class="resultView() === 'tree' ? VIEW_ON : VIEW_OFF" @click="resultView.set('tree')" data-tinkerbelle-view-tree>Inspect</button>
                @endif
                @if(grid())
                  <button type="button" :class="resultView() === 'table' ? VIEW_ON : VIEW_OFF" @click="resultView.set('table')" data-tinkerbelle-view-table>Table</button>
                @endif
                @if(resultModels().length)
                  <button type="button" :class="resultView() === 'graph' ? VIEW_ON : VIEW_OFF" @click="showGraph()" data-tinkerbelle-view-graph>Relations</button>
                @endif
                @if(previewMarkup())
                  <button type="button" :class="resultView() === 'preview' ? VIEW_ON : VIEW_OFF" @click="resultView.set('preview')" data-tinkerbelle-view-preview>Preview</button>
                @endif
                <button type="button" :class="resultView() === 'text' ? VIEW_ON : VIEW_OFF" @click="resultView.set('text')" data-tinkerbelle-view-text>Text</button>
              </h2>

              @if(resultView() === 'tree' && inspectable())
                <div data-tinkerbelle-tree>
                  <JsonTree label="Result" height="calc(100vh - 9.5rem)" depth="2" :tinker="lastValue()" @open="openNode($event)" />
                </div>
              @endif

              @if(resultView() === 'table' && grid())
                <div data-tinkerbelle-table>
                  <DataGrid label="Result rows" fileName="tinkerbelle-result" height="calc(100vh - 9.5rem)" :rows="grid().rows" :columns="grid().columns" />
                  @if(grid().more)
                    <p class="px-3 py-1.5 text-[11px] border-t tb-fg-3 tb-line">{{ grid().more }} more rows were not sent.</p>
                  @endif
                </div>
              @endif

              @if(resultView() === 'graph' && resultModels().length)
                <div data-tinkerbelle-graph>
                  @if(relations().nodes.length)
                    <GraphView id="tinkerbelle-relations" label="Model relations" height="calc(100vh - 9.5rem)" :nodes="relations().nodes" :edges="relations().edges" @expand="expandRelations($event)" />
                  @else
                    <p class="p-3 text-xs tb-fg-2">{{ modelList() ? 'This session lists no relations for that model.' : 'Reading the models...' }}</p>
                  @endif
                </div>
              @endif

              @if(resultView() === 'preview' && previewMarkup())
                <div data-tinkerbelle-preview>
                  <PreviewFrame title="Rendered preview" height="calc(100vh - 9.5rem)" :html="previewMarkup()" />
                </div>
              @endif

              @if(resultView() === 'text' || (resultView() === 'tree' && !inspectable()) || (resultView() === 'table' && !grid()) || (resultView() === 'graph' && !resultModels().length) || (resultView() === 'preview' && !previewMarkup()))
                <pre class="overflow-x-auto p-3 font-mono text-xs whitespace-pre-wrap">{{ result() }}</pre>
              @endif
            </article>
          @endif

          @if(failure())
            <article class="border-b tb-danger-bg tb-danger-line" data-tinkerbelle-error>
              <h2 class="pt-2.5 px-3 text-[10px] tracking-wide uppercase tb-danger-fg">Error</h2>
              <pre class="overflow-x-auto p-3 font-mono text-xs whitespace-pre-wrap tb-danger-fg">{{ failure() }}</pre>
            </article>
          @endif

          @if(queries().length)
            <article class="border-b tb-line" data-tinkerbelle-queries>
              <h2 class="pt-2.5 px-3 text-[10px] tracking-wide uppercase tb-fg-3">Queries ({{ queries().length }})</h2>
              <ul class="divide-y tb-divide">
                @foreach(queries() as query)
                  <li class="flex gap-3 px-3 py-1.5 font-mono text-xs"><span class="shrink-0 tb-fg-3">{{ query.durationMs }} ms</span><span class="min-w-0 break-words">{{ query.sql }}</span></li>
                @endforeach
              </ul>
            </article>
          @endif
          </div>
        </aside>
      </main>

      <footer class="flex gap-1 items-center shrink-0 tb-status" data-tinkerbelle-status>
        <button type="button" :class="paneOpen() ? 'tb-icon tb-icon-on' : 'tb-icon'" :aria-pressed="paneOpen() ? 'true' : 'false'" aria-label="Show or hide the side pane" :title="'Side pane (' + MOD + '+J)'" @click="togglePane()" data-tinkerbelle-pane-toggle><span class="inline-block h-3.5 w-3.5 i-hugeicons-sidebar-right" aria-hidden="true"></span></button>
        <button type="button" class="tb-icon" aria-label="Open the command palette" :title="'Commands (' + MOD + '+K)'" @click="openPalette()" data-tinkerbelle-palette-button><span class="inline-block h-3.5 w-3.5 i-hugeicons-search-01" aria-hidden="true"></span></button>
        <button type="button" class="tb-icon" aria-label="Settings" :title="'Settings (' + MOD + '+,)'" @click="openSettingsWindow()" data-tinkerbelle-settings-button><span class="inline-block h-3.5 w-3.5 i-hugeicons-settings-01" aria-hidden="true"></span></button>
        <span class="ml-2 min-w-0 font-mono truncate" data-tinkerbelle-where>{{ whereLabel() }}</span>
        <span class="flex-1"></span>
        @if(updateInstalled())
          <button type="button" class="flex gap-1.5 items-center shrink-0 tb-status-action" @click="restartForUpdate()" data-tinkerbelle-restart><span class="h-1.5 w-1.5 rounded-full tb-dot-ok" aria-hidden="true"></span>Restart to finish updating</button>
        @elseif(updateReady())
          <button type="button" class="flex gap-1.5 items-center shrink-0 tb-status-action" :disabled="updateBusy()" @click="installUpdate()" data-tinkerbelle-update><span class="h-1.5 w-1.5 rounded-full tb-dot-info" aria-hidden="true"></span>{{ updateBusy() ? 'Updating' : 'Update to ' + update().version }}</button>
        @endif
        <span class="shrink-0 px-1.5" :class="problems() ? 'tb-problems' : ''" data-tinkerbelle-problems>{{ problems() === 0 ? 'No problems' : problems() === 1 ? '1 problem' : problems() + ' problems' }}</span>
        <span class="shrink-0 px-1.5 font-mono">{{ caretLabel() }}</span>
        <span class="shrink-0 px-1.5">TypeScript</span>
      </footer>

      @if(connectOpen())
        <div class="flex fixed inset-0 z-40 items-start justify-center pt-16 tb-scrim" @click.self="connectOpen.set(false)" data-tinkerbelle-connect>
          <div class="max-w-lg w-full border rounded-xl tb-line tb-surface tinkerbelle-float" role="dialog" aria-modal="true" aria-label="Connect to a remote target">
            <div class="flex gap-1 p-2 border-b tb-line" role="tablist">
              <button type="button" role="tab" :aria-selected="connectKind() === 'ssh' ? 'true' : 'false'" :class="connectKind() === 'ssh' ? 'px-3 h-7 text-xs font-medium tb-fill rounded-md' : 'px-3 h-7 text-xs tb-fg-2 rounded-md'" @click="connectKind.set('ssh'); found.set([])">SSH</button>
              <button type="button" role="tab" :aria-selected="connectKind() === 'docker' ? 'true' : 'false'" :class="connectKind() === 'docker' ? 'px-3 h-7 text-xs font-medium tb-fill rounded-md' : 'px-3 h-7 text-xs tb-fg-2 rounded-md'" @click="connectKind.set('docker'); found.set([])">Docker</button>
              <button type="button" role="tab" :aria-selected="connectKind() === 'kube' ? 'true' : 'false'" :class="connectKind() === 'kube' ? 'px-3 h-7 text-xs font-medium tb-fill rounded-md' : 'px-3 h-7 text-xs tb-fg-2 rounded-md'" @click="connectKind.set('kube'); found.set([])">Kubernetes</button>
            </div>
            <div class="pt-3 px-4" data-tinkerbelle-boxes>
              <div class="flex gap-2 items-center">
                <button type="button" class="px-2.5 h-7 text-xs border rounded-md disabled:opacity-50 tb-line" :disabled="boxesLoading()" @click="loadBoxes()">{{ boxesLoading() ? 'Asking the project' : 'Servers this project is deployed to' }}</button>
                <span class="min-w-0 text-[11px] truncate tb-fg-2">{{ boxesNote() }}</span>
              </div>
              @if(boxes().length)
                <ul class="mt-2 border divide-y rounded-md tb-divide tb-line">
                  @foreach(boxes() as box)
                    <li class="flex gap-3 items-baseline px-3 py-1.5 text-xs cursor-default tb-hover" @click="connectBox(box)"><span class="font-medium">{{ box.title }}</span><span class="ml-auto min-w-0 font-mono text-[11px] truncate tb-fg-3">{{ box.connection.directory }}</span></li>
                  @endforeach
                </ul>
              @endif
            </div>
            <div class="grid gap-3 grid-cols-2 p-4">
              @if(connectKind() === 'ssh')
              <label class="flex flex-col gap-1 text-[11px] tb-fg-2">Host
                <input type="text" :value="form().host" @input="setField('host', $event.target.value)" placeholder="box.example.com" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-xs border rounded-md focus:outline-none tb-fg tb-focus tb-line tb-surface">
              </label>
              <label class="flex flex-col gap-1 text-[11px] tb-fg-2">User
                <input type="text" :value="form().user" @input="setField('user', $event.target.value)" placeholder="root" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-xs border rounded-md focus:outline-none tb-fg tb-focus tb-line tb-surface">
              </label>
              <label class="flex flex-col gap-1 text-[11px] tb-fg-2">Port
                <input type="text" :value="form().port" @input="setField('port', $event.target.value)" placeholder="22" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-xs border rounded-md focus:outline-none tb-fg tb-focus tb-line tb-surface">
              </label>
              <label class="flex flex-col gap-1 text-[11px] tb-fg-2">Jump host (optional)
                <input type="text" :value="form().jump" @input="setField('jump', $event.target.value)" placeholder="me@bastion" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-xs border rounded-md focus:outline-none tb-fg tb-focus tb-line tb-surface">
              </label>
              <label class="flex flex-col gap-1 text-[11px] tb-fg-2" style="grid-column: span 2">Identity file (optional)
                <input type="text" :value="form().identityFile" @input="setField('identityFile', $event.target.value)" placeholder="/Users/me/.ssh/id_ed25519" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-xs border rounded-md focus:outline-none tb-fg tb-focus tb-line tb-surface">
              </label>
              @endif
              @if(connectKind() === 'kube')
              <label class="flex flex-col gap-1 text-[11px] tb-fg-2">Context (optional)
                <input type="text" :value="form().context" @input="setField('context', $event.target.value)" placeholder="current context" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-xs border rounded-md focus:outline-none tb-fg tb-focus tb-line tb-surface">
              </label>
              <label class="flex flex-col gap-1 text-[11px] tb-fg-2">Namespace
                <input type="text" :value="form().namespace" @input="setField('namespace', $event.target.value)" placeholder="default" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-xs border rounded-md focus:outline-none tb-fg tb-focus tb-line tb-surface">
              </label>
              @endif
              @if(connectKind() !== 'docker')
              <label class="flex flex-col gap-1 text-[11px] tb-fg-2">Pod
                <input type="text" :value="form().pod" @input="setField('pod', $event.target.value)" placeholder="api-0" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-xs border rounded-md focus:outline-none tb-fg tb-focus tb-line tb-surface">
              </label>
              @endif
              <label class="flex flex-col gap-1 text-[11px] tb-fg-2">Container
                <input type="text" :value="form().container" @input="setField('container', $event.target.value)" placeholder="web-1" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-xs border rounded-md focus:outline-none tb-fg tb-focus tb-line tb-surface">
              </label>
              <label class="flex flex-col gap-1 text-[11px] tb-fg-2" style="grid-column: span 2">Project directory on the target
                <input type="text" :value="form().directory" @input="setField('directory', $event.target.value)" placeholder="/var/www/app/current" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-xs border rounded-md focus:outline-none tb-fg tb-focus tb-line tb-surface">
              </label>
              <label class="flex flex-col gap-1 text-[11px] tb-fg-2">Env file to export (optional)
                <input type="text" :value="form().envFile" @input="setField('envFile', $event.target.value)" placeholder=".env" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-xs border rounded-md focus:outline-none tb-fg tb-focus tb-line tb-surface">
              </label>
              <div class="flex flex-wrap gap-2 items-end">
                <button type="button" class="px-2.5 h-8 text-xs border rounded-md disabled:opacity-50 tb-line" :disabled="finding()" @click="discover('containers')">List containers</button>
                <button type="button" class="px-2.5 h-8 text-xs border rounded-md disabled:opacity-50 tb-line" :disabled="finding()" @click="discover('pods')">List pods</button>
              </div>
            </div>
            @if(found().length)
              <ul class="overflow-y-auto mb-3 mx-4 max-h-40 border divide-y rounded-md tb-divide tb-line" data-tinkerbelle-found>
                @foreach(found() as item)
                  <li class="flex gap-3 px-3 py-1.5 font-mono text-xs cursor-default tb-hover" @click="pick(item)"><span>{{ item.value }}</span><span class="ml-auto truncate tb-fg-3">{{ item.hint }}</span></li>
                @endforeach
              </ul>
            @endif
            <p class="pb-3 px-4 text-[11px] tb-fg-2">Keys come from your SSH agent. TinkerBelle never asks for a password and writes nothing on the target.</p>
            <div class="flex gap-2 justify-end px-4 py-3 border-t tb-line">
              <button type="button" class="px-3 h-8 text-xs border rounded-md tb-line" @click="connectOpen.set(false)">Cancel</button>
              <button type="button" class="px-3 h-8 font-medium text-xs rounded-md disabled:opacity-50 tb-primary" :disabled="connecting()" @click="connectRemote()" data-tinkerbelle-connect-go>{{ connecting() ? 'Connecting' : 'Connect' }}</button>
            </div>
          </div>
        </div>
      @endif

      @if(paletteOpen())
        <div class="flex fixed inset-0 z-40 items-start justify-center pt-24 tb-scrim" @click.self="closePalette()" data-tinkerbelle-palette>
          <div class="overflow-hidden max-w-xl w-full border rounded-xl tb-line tb-surface tinkerbelle-float" role="dialog" aria-modal="true" aria-label="Command palette">
            <input
              ref="paletteInput"
              type="text"
              role="combobox"
              aria-expanded="true"
              aria-controls="tinkerbelle-palette-list"
              aria-label="Search commands, projects, snippets and history"
              placeholder="Search commands, projects, snippets and history"
              :value="paletteQuery()"
              @input="paletteQuery.set($event.target.value); paletteActive.set(0)"
              @keydown="paletteKey($event)"
              class="px-4 h-12 w-full text-sm bg-transparent border-b focus:outline-none tb-line"
            >
            <ul id="tinkerbelle-palette-list" role="listbox" class="overflow-y-auto py-1 max-h-96">
              @foreach(paletteItems() as item, index)
                <li
                  role="option"
                  :aria-selected="index === paletteActive() ? 'true' : 'false'"
                  :class="index === paletteActive() ? 'flex gap-3 items-baseline px-4 py-2 cursor-default tb-fill ' : 'flex gap-3 items-baseline px-4 py-2 cursor-default'"
                  @click="choose(item)"
                  @mousemove="paletteActive.set(index)"
                >
                  @if(item.kind !== 'action')
                    <span :class="PALETTE_ICONS[item.kind] || 'i-hugeicons-folder-01'" class="inline-block self-center shrink-0 h-4 w-4 tb-fg-3" aria-hidden="true"></span>
                  @endif
                  <span :class="item.kind === 'snippet' || item.kind === 'history' ? 'min-w-0 font-mono text-xs truncate' : 'min-w-0 text-[13px] truncate'">{{ item.title }}</span>
                  <span class="ml-auto min-w-0 text-[11px] truncate tb-fg-3">{{ item.hint }}</span>
                </li>
              @endforeach
              @if(paletteItems().length === 0)
                <li class="px-4 py-3 text-sm tb-fg-2">Nothing matches.</li>
              @endif
            </ul>
          </div>
        </div>
      @endif
    </div>
    </div>
  </body>
</html>
