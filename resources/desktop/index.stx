<script client>
import { fuzzyFilter } from '../functions/fuzzy'
import { componentApi } from '@stacksjs/components/component-api'
import { modelsIn, neighbourhood } from '../functions/relation-graph'
import { gridOf } from '../functions/tinker-table'
import { renderTinkerValue } from '../functions/tinker-value'

const code = state('const numbers = [1, 2, 3]\nnumbers.map(n => n * 2)\n')
const connection = state(null)
const projectPath = state('')
const connecting = state(false)
const running = state(false)
const notice = state('')
const output = state('')
const result = state('')
const failure = state('')
const duration = state('')
const queries = state([])

const widgets = state([])
const recent = state([])
const snippets = state([])
const historyEntries = state([])
const paletteOpen = state(false)
const paletteQuery = state('')
const paletteActive = state(0)
const paletteInput = useRef('paletteInput')
const diagnostics = state([])
const editorRef = ref()
let checkTimer = 0
let checkSerial = 0

const view = state('result')
// The window is the editor. The side pane opens when there is something to show in it.
const paneOpen = state(false)
const switcherOpen = state(false)
const caretLabel = state('Ln 1, Col 1')
const MOD = /Mac|iPhone|iPad/i.test(navigator.userAgent) ? 'Cmd' : 'Ctrl'
const MOD_KEY = MOD === 'Cmd' ? '\u2318' : 'Ctrl'
const RUN_KEYS = MOD === 'Cmd' ? '\u2318\u21B5' : 'Ctrl+Enter'
const logLines = state([])
const logLevel = state('all')
const logQuery = state('')
const logFollowing = state(false)
const logNote = state('')
let logAbort = null

const LOG_RANK = { debug: 0, info: 1, success: 1, warning: 2, error: 3 }
const shownLogs = derived(() => {
  const floor = logLevel() === 'all' ? -1 : LOG_RANK[logLevel()]
  const query = logQuery().trim().toLowerCase()
  return logLines().filter(line => LOG_RANK[line.level] >= floor && (!query || line.raw.toLowerCase().includes(query)))
})

function stopLogs() {
  if (logAbort) logAbort.abort()
  logAbort = null
  logFollowing.set(false)
}

// Lines are read from a response that stays open: each one is shown as the target writes it.
async function followLogs() {
  stopLogs()
  logLines.set([])
  logNote.set('')
  if (!connected()) return
  logAbort = new AbortController()
  logFollowing.set(true)
  try {
    const response = await fetch('/__fettler/logs', { signal: logAbort.signal })
    if (!response.ok || !response.body) {
      const body = await response.json().catch(() => ({}))
      logNote.set(body.error || 'The log could not be followed.')
      return
    }
    const reader = response.body.getReader()
    const decoder = new TextDecoder()
    let pending = ''
    for (;;) {
      const { value, done } = await reader.read()
      if (done) break
      pending += decoder.decode(value, { stream: true })
      const parts = pending.split('\n')
      pending = parts.pop() || ''
      const fresh = parts.filter(Boolean).map(part => JSON.parse(part))
      if (fresh.length) logLines.set([...logLines(), ...fresh].slice(-2000))
    }
  }
  catch (cause) {
    if (!(cause && cause.name === 'AbortError')) logNote.set(cause instanceof Error ? cause.message : 'The log stopped.')
  }
  finally {
    logFollowing.set(false)
  }
}

function showView(name) {
  view.set(name)
  paneOpen.set(true)
  if (name === 'logs' && !logFollowing()) void followLogs()
  if (name === 'info') void loadPanels()
  if (name !== 'logs') stopLogs()
}

function logClass(level) {
  if (level === 'error') return 'text-red-700 dark:text-red-300'
  if (level === 'warning') return 'text-amber-700 dark:text-amber-300'
  if (level === 'debug') return 'text-neutral-400'
  return 'text-neutral-700 dark:text-neutral-200'
}

const ai = state({ enabled: false, provider: 'anthropic', model: '', host: '', automatic: false, hasKey: false })
const aiOpen = state(false)
const aiKey = state('')
const aiSaving = state(false)
const chat = state([])
const question = state('')
const asking = state(false)
const chatNote = state('')
const ghost = state('')
let ghostTimer = 0
let ghostAbort = null
let caret = { line: 0, column: 0 }

async function loadAi() {
  const response = await fetch('/__fettler/ai')
  if (response.ok) ai.set(await response.json())
}

function setAi(name, value) {
  ai.set({ ...ai(), [name]: value })
}

async function saveAi() {
  aiSaving.set(true)
  try {
    const { hasKey: _hasKey, ...settings } = ai()
    const response = await fetch('/__fettler/ai', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ ...settings, ...(aiKey().trim() ? { key: aiKey().trim() } : {}) }),
    })
    if (response.ok) ai.set(await response.json())
    aiKey.set('')
    aiOpen.set(false)
  }
  finally {
    aiSaving.set(false)
  }
}

async function forgetKey() {
  const response = await fetch('/__fettler/ai', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ key: null }) })
  if (response.ok) ai.set(await response.json())
}

function offsetOf(text, line, column) {
  const lines = text.split('\n')
  let offset = 0
  for (let index = 0; index < line && index < lines.length; index++) offset += lines[index].length + 1
  return offset + column
}

// A suggestion at the cursor. Asked for with Alt+Backslash, or after a pause when that is turned on.
async function suggest() {
  if (!ai().enabled || !ai().hasKey) return
  if (ghostAbort) ghostAbort.abort()
  ghostAbort = new AbortController()
  const text = code()
  const at = offsetOf(text, caret.line, caret.column)
  try {
    const response = await fetch('/__fettler/ai/suggest', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ before: text.slice(0, at), after: text.slice(at) }),
      signal: ghostAbort.signal,
    })
    const body = await response.json()
    ghost.set(response.ok ? (body.suggestion || '') : '')
    if (!response.ok && body.error) notice.set(body.error)
  }
  catch (cause) {
    if (!(cause && cause.name === 'AbortError')) ghost.set('')
  }
}

function scheduleSuggest() {
  clearTimeout(ghostTimer)
  ghost.set('')
  if (ai().enabled && ai().automatic && ai().hasKey) ghostTimer = setTimeout(suggest, 700)
}

function onSelection(detail) {
  if (!detail) return
  caret = { line: detail.line, column: detail.column }
  caretLabel.set(`Ln ${detail.line + 1}, Col ${detail.column + 1}`)
}

async function ask() {
  const text = question().trim()
  if (!text || asking()) return
  const messages = [...chat(), { role: 'user', content: text }]
  chat.set(messages)
  question.set('')
  asking.set(true)
  chatNote.set('')
  try {
    const response = await fetch('/__fettler/ai/ask', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ messages: messages.map(message => ({ role: message.role, content: message.content })), code: code() }),
    })
    const body = await response.json()
    if (!response.ok) {
      chatNote.set(body.error || 'The assistant could not answer.')
      if (body.notReady) aiOpen.set(true)
      return
    }
    chat.set([...messages, { role: 'assistant', content: body.answer, code: body.code }])
  }
  catch (cause) {
    chatNote.set(cause instanceof Error ? cause.message : 'The assistant could not answer.')
  }
  finally {
    asking.set(false)
  }
}

function useCode(source) {
  code.set(source)
  scheduleCheck()
  showView('result')
}

const panels = state([])
const panelsNote = state('')

async function loadPanels() {
  panels.set([])
  panelsNote.set('')
  if (!connected()) return
  const response = await fetch('/__fettler/panels')
  const body = await response.json().catch(() => ({}))
  panels.set(body.panels || [])
  if (body.error) panelsNote.set(body.error)
}

const boxes = state([])
const boxesNote = state('')
const boxesLoading = state(false)

// The servers this project is deployed to, as the project itself reports them.
async function loadBoxes() {
  boxesLoading.set(true)
  boxes.set([])
  boxesNote.set('')
  try {
    const response = await fetch('/__fettler/boxes', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ environment: 'production' }) })
    const body = await response.json()
    if (!response.ok) throw new Error(body.error || 'The deploys could not be listed.')
    boxes.set(body.targets || [])
    // The project's own words when it has them: "not deployed from this checkout" is more use than "none".
    boxesNote.set((body.warnings || []).join(' ') || (body.targets && body.targets.length ? '' : 'This project has no server deploys for production.'))
  }
  catch (cause) {
    boxesNote.set(cause instanceof Error ? cause.message : 'The deploys could not be listed.')
  }
  finally {
    boxesLoading.set(false)
  }
}

async function connectBox(target) {
  await connect(target.connection)
  if (connected() && connection().kind === 'ssh') connectOpen.set(false)
}

const license = state({ pro: false, source: 'none', standing: null, version: '', buildDate: '' })
const licenseOpen = state(false)
const licenseKey = state('')
const licenseNote = state('')
const licenseBusy = state(false)
const licenseDevices = state([])

const licenseSummary = derived(() => {
  const current = license()
  if (current.source === 'license' && current.standing) {
    const until = current.standing.updatesUntil
    return current.standing.tier === 'lifetime' ? 'Pro, lifetime license' : until ? `Pro, updates until ${until.slice(0, 10)}` : 'Pro'
  }
  if (current.source === 'beta') return 'Beta: every feature is open until licenses go on sale'
  if (current.standing && current.standing.licensed) return 'Licensed, but this build is newer than the license covers. Remote targets and AI are locked on it.'
  return 'Free: local projects and the sandbox'
})

async function loadLicense() {
  const response = await fetch('/__fettler/license')
  if (response.ok) license.set(await response.json())
}

async function activateLicense() {
  licenseBusy.set(true)
  licenseNote.set('')
  licenseDevices.set([])
  try {
    const response = await fetch('/__fettler/license', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ key: licenseKey() }) })
    const body = await response.json()
    if (body.ok) {
      license.set(body.entitlements)
      licenseKey.set('')
      licenseNote.set('This device is activated.')
    }
    else {
      licenseNote.set(body.message || body.error || 'The key could not be activated.')
      licenseDevices.set(body.devices || [])
    }
  }
  catch (cause) {
    licenseNote.set(cause instanceof Error ? cause.message : 'The key could not be activated.')
  }
  finally {
    licenseBusy.set(false)
  }
}

async function releaseLicense() {
  const response = await fetch('/__fettler/license', { method: 'DELETE' })
  if (response.ok) license.set(await response.json())
  licenseNote.set('This device no longer uses the license.')
}

const mcpOpen = state(false)
const mcp = state({ enabled: false, address: '', token: '' })

async function loadMcp() {
  const response = await fetch('/__fettler/mcp-settings')
  if (response.ok) mcp.set({ token: '', ...(await response.json()) })
}

async function setMcp(enabled) {
  const response = await fetch('/__fettler/mcp-settings', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ enabled }) })
  if (response.ok) mcp.set({ token: '', ...(await response.json()) })
}

// What an MCP client is given: the address and the bearer token, in the shape most of them take.
const mcpConfig = derived(() => JSON.stringify({ mcpServers: { fettler: { type: 'http', url: mcp().address, headers: { Authorization: `Bearer ${mcp().token || 'the token shown when you turned this on'}` } } } }, null, 2))

const lastValue = state(null)
const resultView = state('text')

// A scalar reads best as text. Anything with parts gets the inspector.
const SCALARS = ['string', 'number', 'boolean', 'bigint', 'null', 'undefined', 'date', 'url', 'regexp', 'symbol']
const inspectable = derived(() => Boolean(lastValue()) && !SCALARS.includes(lastValue().t) && lastValue().t !== 'html')
const grid = derived(() => gridOf(lastValue()))
const previewMarkup = derived(() => lastValue() && lastValue().t === 'html' ? lastValue().html : '')

// The relation graph is drawn from the session's own list of models, asked for once per connection.
const modelList = state(null)
const resultModels = derived(() => modelsIn(lastValue()))
const relations = derived(() => modelList() && resultModels().length ? neighbourhood(modelList(), resultModels()) : { nodes: [], edges: [] })

async function loadModels() {
  if (modelList()) return
  const response = await fetch('/__fettler/models')
  modelList.set(response.ok ? (await response.json()).models || [] : [])
}

function showGraph() {
  resultView.set('graph')
  void loadModels()
}

function expandRelations(detail) {
  if (!detail || !detail.node || !modelList()) return
  const more = neighbourhood(modelList(), [detail.node.id])
  const graph = componentApi('fettler-relations')
  graph.addNeighbours(detail.node.id, more.nodes.filter(node => node.id !== detail.node.id), more.edges)
  graph.updateNode(detail.node.id, { expandable: false })
}

// A node in the inspector that is a list of records or a page opens in the view made for it.
function openNode(detail) {
  if (!detail) return
  if (detail.as === 'table' && grid()) resultView.set('table')
  else if (detail.as === 'preview' && previewMarkup()) resultView.set('preview')
  else if (detail.as === 'graph' && resultModels().length) showGraph()
}

const PALETTE_ICONS = { project: 'i-hugeicons-folder-01', snippet: 'i-hugeicons-note-01', history: 'i-hugeicons-clock-01', ssh: 'i-hugeicons-cloud-server', docker: 'i-hugeicons-package', kube: 'i-hugeicons-package' }
const PANE_VIEWS = [{ id: 'result', title: 'Result' }, { id: 'logs', title: 'Log' }, { id: 'assistant', title: 'Assistant' }, { id: 'info', title: 'Info' }]

const VIEW_ON = 'px-1.5 h-5 rounded bg-neutral-200/80 dark:bg-neutral-800 text-neutral-900 dark:text-neutral-100'
const VIEW_OFF = 'px-1.5 h-5 rounded hover:text-neutral-900 dark:hover:text-neutral-100'

const tabs = state([{ id: 't1', title: 'Untitled', code: code() }])
const activeTab = state('t1')
const ui = state({ theme: 'system', fontSize: 13 })
let saveTimer = 0
let tabCounter = 1

// "System" follows the machine: the dark variants are class based, so the class is set from the media query.
const systemDark = useMediaQuery('(prefers-color-scheme: dark)')
const themeClass = derived(() => ui().theme === 'dark' || (ui().theme !== 'light' && systemDark()) ? 'dark' : 'light')
const editorTheme = derived(() => ui().theme === 'system' ? undefined : ui().theme)
const editorStyle = derived(() => `--stx-code-font-size: ${ui().fontSize}px; --stx-code-line-height: ${Math.round(ui().fontSize * 1.55)}px`)

function tabTitle(tab) {
  const line = (tab.code || '').split('\n').find(part => part.trim()) || ''
  return line ? (line.length > 22 ? `${line.slice(0, 22)}...` : line) : 'Untitled'
}

// The buffers are written a moment after the last change, so closing the window loses nothing.
function scheduleSave() {
  clearTimeout(saveTimer)
  saveTimer = setTimeout(() => {
    const current = tabs().map(tab => tab.id === activeTab() ? { ...tab, code: code() } : tab)
    void fetch('/__fettler/workspace', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ tabs: current, active: activeTab(), ui: ui() }) })
  }, 500)
}

function selectTab(id) {
  if (id === activeTab()) return
  tabs.set(tabs().map(tab => tab.id === activeTab() ? { ...tab, code: code() } : tab))
  const next = tabs().find(tab => tab.id === id)
  if (!next) return
  activeTab.set(id)
  code.set(next.code)
  widgets.set([])
  ghost.set('')
  scheduleCheck()
  scheduleSave()
}

function newTab() {
  tabs.set(tabs().map(tab => tab.id === activeTab() ? { ...tab, code: code() } : tab))
  const id = `t${Date.now().toString(36)}${++tabCounter}`
  tabs.set([...tabs(), { id, title: 'Untitled', code: '' }])
  activeTab.set(id)
  code.set('')
  widgets.set([])
  diagnostics.set([])
  scheduleSave()
}

function closeTab(id) {
  if (tabs().length === 1) {
    code.set('')
    tabs.set([{ ...tabs()[0], code: '' }])
    scheduleSave()
    return
  }
  const index = tabs().findIndex(tab => tab.id === id)
  const remaining = tabs().filter(tab => tab.id !== id)
  tabs.set(remaining)
  if (id === activeTab()) {
    const next = remaining[Math.max(0, index - 1)]
    activeTab.set(next.id)
    code.set(next.code)
    scheduleCheck()
  }
  scheduleSave()
}

function setUi(name, value) {
  ui.set({ ...ui(), [name]: value })
  scheduleSave()
}

async function loadWorkspace() {
  const response = await fetch('/__fettler/workspace')
  if (!response.ok) return
  const body = await response.json()
  if (body.ui && body.ui.fontSize) ui.set({ theme: body.ui.theme || 'system', fontSize: body.ui.fontSize })
  if (Array.isArray(body.tabs) && body.tabs.length) {
    tabs.set(body.tabs)
    const active = body.tabs.find(tab => tab.id === body.active) || body.tabs[0]
    activeTab.set(active.id)
    code.set(active.code)
  }
}

const connectOpen = state(false)
const connectKind = state('ssh')
const form = state({ host: '', user: '', port: '', identityFile: '', jump: '', directory: '', envFile: '.env', container: '', pod: '', namespace: '', context: '' })
const found = state([])
const finding = state(false)
const confirming = state('')

const isProduction = derived(() => /prod|live/i.test((connection() && connection().environment) || ''))
const environmentLabel = derived(() => (connection() && connection().environment) || '')
const whereLabel = derived(() => (connection() && connection().where) || '')
const connected = derived(() => connection() !== null)
const dotClass = derived(() => !connected() ? 'bg-neutral-300 dark:bg-neutral-600' : isProduction() ? 'bg-red-500' : 'bg-emerald-500')
const problems = derived(() => diagnostics().filter(item => item.severity !== 'info' && item.severity !== 'hint').length)
const recentProjects = derived(() => recent().filter(item => item.kind === 'local' || (item.spec && item.kind !== 'sandbox')).slice(0, 6))

function focusEditor() {
  const editor = editorRef.value && editorRef.value.__stx_exposed
  if (editor) editor.focus()
}

function togglePane() {
  paneOpen.set(!paneOpen())
  if (!paneOpen()) { stopLogs(); focusEditor() }
}

function closeSwitcher() {
  switcherOpen.set(false)
  focusEditor()
}

async function openRecent(item) {
  switcherOpen.set(false)
  if (item.kind === 'local') {
    projectPath.set(item.path)
    await connect({ kind: 'local', path: item.path })
  }
  else {
    await connect(item.spec)
  }
}

async function openSandbox() {
  switcherOpen.set(false)
  await connect({ kind: 'sandbox' })
}

function openRemote() {
  switcherOpen.set(false)
  connectOpen.set(true)
}
const targetLabel = derived(() => connection() ? connection().label : 'Not connected')

let firstState = true

async function loadState() {
  const response = await fetch('/__fettler/state')
  if (!response.ok) return
  const body = await response.json()
  const first = firstState
  firstState = false
  // With nothing open, the sandbox is: the editor should run something the moment the window is up.
  if (first && !body.connection) { void connect({ kind: 'sandbox' }) }
  connection.set(body.connection)
  recent.set(body.recent || [])
  if (body.note && !notice()) notice.set(body.note)
  if (body.connection && body.connection.path && !projectPath()) projectPath.set(body.connection.kind === 'local' ? body.connection.path : '')
}

function firstLine(text) {
  const line = (text || '').split('\n').find(part => part.trim()) || ''
  return line.length > 90 ? `${line.slice(0, 90)}...` : line
}

// Everything the palette can do, as one list: actions, then projects, snippets and what was run.
const paletteItems = derived(() => {
  const items = [
    { kind: 'action', id: 'run', title: 'Run', hint: `${MOD}+Enter` },
    { kind: 'action', id: 'open', title: 'Open a project', hint: `${MOD}+O` },
    { kind: 'action', id: 'sandbox', title: 'Open the sandbox', hint: '' },
    { kind: 'action', id: 'remote', title: 'Connect to a server, container or pod', hint: '' },
    { kind: 'action', id: 'pane', title: 'Show or hide the side pane', hint: `${MOD}+J` },
    { kind: 'action', id: 'result', title: 'Show the result', hint: '' },
    { kind: 'action', id: 'logs', title: 'Follow the log', hint: '' },
    { kind: 'action', id: 'info', title: 'About this connection', hint: '' },
    { kind: 'action', id: 'assistant', title: 'Ask the assistant', hint: '' },
    { kind: 'action', id: 'mcp', title: 'Let AI tools use Fettler (MCP)', hint: mcp().enabled ? 'on' : 'off' },
    { kind: 'action', id: 'license', title: 'License', hint: license().source === 'license' ? 'Pro' : license().source === 'beta' ? 'beta' : 'free' },
    { kind: 'action', id: 'new-tab', title: 'New buffer', hint: '' },
    { kind: 'action', id: 'theme-system', title: 'Theme: follow the system', hint: ui().theme === 'system' ? 'current' : '' },
    { kind: 'action', id: 'theme-light', title: 'Theme: light', hint: ui().theme === 'light' ? 'current' : '' },
    { kind: 'action', id: 'theme-dark', title: 'Theme: dark', hint: ui().theme === 'dark' ? 'current' : '' },
    { kind: 'action', id: 'font-up', title: 'Larger code', hint: `${ui().fontSize}px` },
    { kind: 'action', id: 'font-down', title: 'Smaller code', hint: `${ui().fontSize}px` },
    { kind: 'action', id: 'ai-settings', title: 'AI settings', hint: ai().enabled ? ai().provider : 'off' },
    { kind: 'action', id: 'suggest', title: 'Suggest at the cursor', hint: 'Alt+Backslash' },
    { kind: 'action', id: 'save', title: 'Save as snippet', hint: firstLine(code()) },
    { kind: 'action', id: 'clear-history', title: 'Clear history for this connection', hint: '' },
  ]
  for (const item of recent()) {
    if (item.kind === 'local') items.push({ kind: 'project', id: item.key, title: `Open ${item.label}`, hint: item.path, path: item.path })
    else if (item.spec && item.kind !== 'sandbox') items.push({ kind: item.kind, id: item.key, title: `Open ${item.label}`, hint: item.where || '', spec: item.spec })
  }
  for (const item of snippets()) items.push({ kind: 'snippet', id: `s${item.id}`, title: item.title, hint: firstLine(item.code), code: item.code })
  for (const item of historyEntries()) items.push({ kind: 'history', id: `h${item.id}`, title: firstLine(item.code), hint: item.ok ? '' : 'failed', code: item.code })
  return fuzzyFilter(paletteQuery(), items, item => `${item.title} ${item.hint || ''}`).slice(0, 80)
})

async function openPalette() {
  paletteQuery.set('')
  paletteActive.set(0)
  paletteOpen.set(true)
  await nextTick()
  if (paletteInput.value) paletteInput.value.focus()
  const [snippetsResponse, historyResponse] = await Promise.all([fetch('/__fettler/snippets'), fetch('/__fettler/history')])
  if (snippetsResponse.ok) snippets.set((await snippetsResponse.json()).snippets || [])
  if (historyResponse.ok) historyEntries.set((await historyResponse.json()).entries || [])
  await loadState()
}

function closePalette() {
  paletteOpen.set(false)
  const editor = editorRef.value && editorRef.value.__stx_exposed
  if (editor) editor.focus()
}

async function choose(item) {
  if (!item) return
  closePalette()
  if (item.kind === 'snippet' || item.kind === 'history') {
    code.set(item.code)
    scheduleCheck()
  }
  else if (item.kind === 'project') {
    projectPath.set(item.path)
    await connect({ kind: 'local', path: item.path })
  }
  else if (item.spec) {
    await connect(item.spec)
  }
  else if (item.id === 'remote') {
    connectOpen.set(true)
  }
  else if (item.id === 'assistant' || item.id === 'logs' || item.id === 'info' || item.id === 'result') {
    showView(item.id)
  }
  else if (item.id === 'pane') {
    togglePane()
  }
  else if (item.id === 'open') {
    switcherOpen.set(true)
  }
  else if (item.id === 'ai-settings') {
    aiOpen.set(true)
  }
  else if (item.id === 'license') {
    await loadLicense()
    licenseNote.set('')
    licenseOpen.set(true)
  }
  else if (item.id === 'new-tab') {
    newTab()
  }
  else if (item.id.startsWith('theme-')) {
    setUi('theme', item.id.slice(6))
  }
  else if (item.id === 'font-up' || item.id === 'font-down') {
    setUi('fontSize', Math.min(22, Math.max(10, ui().fontSize + (item.id === 'font-up' ? 1 : -1))))
  }
  else if (item.id === 'mcp') {
    await loadMcp()
    mcpOpen.set(true)
  }
  else if (item.id === 'suggest') {
    await suggest()
  }
  else if (item.id === 'run') {
    runAll()
  }
  else if (item.id === 'sandbox') {
    await connect({ kind: 'sandbox' })
  }
  else if (item.id === 'save') {
    await fetch('/__fettler/snippets', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ title: firstLine(code()) || 'Untitled', code: code(), scoped: connection() && connection().kind === 'local' }),
    })
    notice.set('Saved as a snippet.')
  }
  else if (item.id === 'clear-history') {
    await fetch('/__fettler/history', { method: 'DELETE' })
    notice.set('History cleared.')
  }
}

function paletteKey(event) {
  const count = paletteItems().length
  if (event.key === 'ArrowDown') { event.preventDefault(); paletteActive.set(count ? (paletteActive() + 1) % count : 0) }
  else if (event.key === 'ArrowUp') { event.preventDefault(); paletteActive.set(count ? (paletteActive() - 1 + count) % count : 0) }
  else if (event.key === 'Enter') { event.preventDefault(); void choose(paletteItems()[paletteActive()]) }
  else if (event.key === 'Escape') { event.preventDefault(); closePalette() }
}

function appKey(event) {
  if (event.altKey && event.code === 'Backslash') {
    event.preventDefault()
    void suggest()
    return
  }
  if (event.key === 'Escape' && switcherOpen()) {
    event.preventDefault()
    closeSwitcher()
    return
  }
  if (!(event.metaKey || event.ctrlKey)) return
  const key = event.key.toLowerCase()
  if (key === 'k') {
    event.preventDefault()
    if (paletteOpen()) closePalette()
    else void openPalette()
  }
  else if (key === 'j') {
    event.preventDefault()
    togglePane()
  }
  else if (key === 'o') {
    event.preventDefault()
    switcherOpen.set(!switcherOpen())
  }
  else if (key === 't') {
    event.preventDefault()
    newTab()
  }
}

async function connect(target) {
  connecting.set(true)
  notice.set('')
  try {
    const response = await fetch('/__fettler/connect', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(target),
    })
    const body = await response.json()
    if (!response.ok) throw new Error(body.error || 'Could not connect.')
    connection.set(body.connection)
    modelList.set(null)
    scheduleCheck()
    const warnings = body.session?.warnings || []
    notice.set(warnings.length ? warnings.join(' ') : '')
  }
  catch (cause) {
    notice.set(cause instanceof Error ? cause.message : 'Could not connect.')
  }
  finally {
    connecting.set(false)
  }
}

function setField(name, value) {
  form.set({ ...form(), [name]: value })
}

function sshPart() {
  const f = form()
  if (!f.host.trim()) return undefined
  return {
    host: f.host.trim(),
    ...(f.user.trim() ? { user: f.user.trim() } : {}),
    ...(f.port.trim() ? { port: Number(f.port) } : {}),
    ...(f.identityFile.trim() ? { identityFile: f.identityFile.trim() } : {}),
    ...(f.jump.trim() ? { jump: f.jump.trim() } : {}),
  }
}

function remoteTarget() {
  const f = form()
  const project = { directory: f.directory.trim(), ...(f.envFile.trim() ? { envFile: f.envFile.trim() } : {}) }
  const pod = f.pod.trim()
    ? { pod: f.pod.trim(), ...(f.namespace.trim() ? { namespace: f.namespace.trim() } : {}), ...(f.context.trim() ? { context: f.context.trim() } : {}), ...(f.container.trim() ? { container: f.container.trim() } : {}) }
    : undefined
  if (connectKind() === 'ssh') {
    return { kind: 'ssh', ...sshPart(), ...project, ...(pod ? { pod } : f.container.trim() ? { container: f.container.trim() } : {}) }
  }
  if (connectKind() === 'docker') return { kind: 'docker', container: f.container.trim(), ...project }
  return { kind: 'kube', ...pod, ...project }
}

// List what is running on the target, so a container or a pod is picked, not typed.
async function discover(what) {
  finding.set(true)
  found.set([])
  notice.set('')
  try {
    const f = form()
    const response = await fetch('/__fettler/discover', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ what, ssh: connectKind() === 'ssh' ? sshPart() : undefined, context: f.context.trim() || undefined, namespace: f.namespace.trim() || undefined }),
    })
    const body = await response.json()
    if (!response.ok) throw new Error(body.error || 'Nothing could be listed.')
    if (what === 'containers') found.set(body.containers.map(item => ({ field: 'container', value: item.name, hint: `${item.image} (${item.status})` })))
    else if (what === 'pods') found.set(body.pods.map(item => ({ field: 'pod', value: item.name, hint: item.phase })))
    else if (what === 'contexts') found.set(body.contexts.map(item => ({ field: 'context', value: item, hint: '' })))
    else if (what === 'namespaces') found.set(body.namespaces.map(item => ({ field: 'namespace', value: item, hint: '' })))
  }
  catch (cause) {
    notice.set(cause instanceof Error ? cause.message : 'Nothing could be listed.')
  }
  finally {
    finding.set(false)
  }
}

async function pick(item) {
  setField(item.field, item.value)
  found.set([])
  if (item.field !== 'container' || form().directory.trim()) return
  const response = await fetch('/__fettler/discover', {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ what: 'workdir', container: item.value, ssh: connectKind() === 'ssh' ? sshPart() : undefined }),
  })
  const body = await response.json().catch(() => ({}))
  if (body.workdir) setField('directory', body.workdir)
}

async function connectRemote() {
  await connect(remoteTarget())
  if (connected() && connection().kind !== 'sandbox' && connection().kind !== 'local') connectOpen.set(false)
}

function connectProject() {
  const path = projectPath().trim()
  if (!path) return
  switcherOpen.set(false)
  void connect({ kind: 'local', path })
}

function take(frame) {
  // Colour codes are for a terminal. Here they are noise.
  if (frame.type === 'stdout' || frame.type === 'stderr' || frame.type === 'stray') output.set(output() + frame.text.replace(/\u001B\[[0-9;]*[A-Za-z]/g, ''))
  else if (frame.type === 'dump') output.set(`${output()}${renderTinkerValue(frame.value)}\n`)
  else if (frame.type === 'query') queries.set([...queries(), frame])
  else if (frame.type === 'probe') {
    const text = frame.kind === 'time' ? `${frame.ms} ms` : renderTinkerValue(frame.value).replace(/\s*\n\s*/g, ' ')
    widgets.set([...widgets(), { line: frame.line, text: text.length > 120 ? `${text.slice(0, 120)}...` : text, kind: frame.kind === 'time' ? 'info' : 'result' }])
  }
  else if (frame.type === 'result') {
    result.set(renderTinkerValue(frame.value))
    duration.set(`${frame.durationMs} ms`)
    lastValue.set(frame.value)
    // Open on the view that suits the value: a page for markup, a table for a list of records.
    resultView.set(frame.value.t === 'html' ? 'preview' : gridOf(frame.value) ? 'table' : SCALARS.includes(frame.value.t) ? 'text' : 'tree')
  }
  else if (frame.type === 'error') { failure.set(renderTinkerValue(frame.error)); duration.set(`${frame.durationMs} ms`) }
  else if (frame.type === 'agent-error') failure.set(frame.message)
}

async function run(source) {
  if (running() || !connected()) return
  running.set(true)
  view.set('result')
  paneOpen.set(true)
  stopLogs()
  output.set('')
  result.set('')
  failure.set('')
  duration.set('')
  queries.set([])
  widgets.set([])
  lastValue.set(null)
  try {
    const response = await fetch('/__fettler/run', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ code: source }),
    })
    if (!response.ok || !response.body) {
      const body = await response.json().catch(() => ({}))
      throw new Error(body.error || 'The run could not start.')
    }
    const reader = response.body.getReader()
    const decoder = new TextDecoder()
    let pending = ''
    for (;;) {
      const { value, done } = await reader.read()
      if (done) break
      pending += decoder.decode(value, { stream: true })
      const lines = pending.split('\n')
      pending = lines.pop() || ''
      for (const line of lines) if (line) take(JSON.parse(line))
    }
  }
  catch (cause) {
    failure.set(cause instanceof Error ? cause.message : 'The run failed.')
  }
  finally {
    running.set(false)
  }
}

async function language(op, text, line, column) {
  const response = await fetch('/__fettler/language', {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ op, text, line, column }),
  })
  return response.ok ? response.json() : {}
}

// Completions come from the project's own TypeScript server, so a model's
// columns and an action's parameters are what is offered.
async function complete(detail) {
  if (!connected() || !detail) return
  const body = await language('complete', code(), detail.line, detail.column)
  // A ref on a component is its element; what the component exposes hangs off it.
  const editor = editorRef.value && editorRef.value.__stx_exposed
  if (!editor || !body.items) return
  const query = (detail.query || '').toLowerCase()
  const items = body.items
    .filter(item => !query || item.label.toLowerCase().startsWith(query))
    .slice(0, 60)
    .map(item => ({ label: item.label, kind: item.kind, detail: item.detail, insert: item.insert }))
  if (items.length) editor.showCompletions(items, { from: detail.from })
}

function scheduleCheck() {
  clearTimeout(checkTimer)
  if (!connected()) return
  checkTimer = setTimeout(async () => {
    const serial = ++checkSerial
    const body = await language('diagnostics', code(), 0, 0)
    if (serial === checkSerial) diagnostics.set(body.diagnostics || [])
  }, 350)
}

// On production a run is asked for twice: once to say what it will touch, once to do it.
function guarded(source) {
  if (!isProduction() || confirming() === source) {
    confirming.set('')
    void run(source)
    return
  }
  confirming.set(source)
}

function runAll(detail) {
  guarded(detail && typeof detail.value === 'string' ? detail.value : code())
}

function runSelection(detail) {
  if (detail && detail.text) guarded(detail.text)
}

// App-wide shortcuts work wherever the focus is, including before anything has been clicked.
useEventListener('keydown', appKey)
// Coming back to the window picks up what changed while it was away: a project opened by `fettler <path>`, for one.
useEventListener('focus', () => { void loadState() })

void loadState()
void loadAi()
void loadMcp()
void loadWorkspace()
void loadLicense()
</script>

@nolayout
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Fettler</title>
    <style>
      /* The editor is the window: no frame of its own, and the page's background behind the code. */
      [data-fettler-editor] [data-stx-code-editor] { border: 0; border-radius: 0; --stx-code-bg: transparent; --stx-code-padding-y: 14px; --stx-code-padding-x: 16px; }
      .fettler-pane { width: 44%; min-width: 320px; max-width: 760px; }
      .fettler-float { box-shadow: 0 16px 48px -16px rgb(0 0 0 / 0.28), 0 2px 6px -2px rgb(0 0 0 / 0.08); }
      body { font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI Variable', 'Segoe UI', system-ui, sans-serif; }
    </style>
  </head>
  <body class="overflow-hidden h-screen antialiased text-neutral-900 dark:text-neutral-100 bg-neutral-50 dark:bg-neutral-950">
    <div :class="themeClass()" data-fettler-theme>
    <div class="flex flex-col h-screen text-neutral-900 dark:text-neutral-100 bg-neutral-50 dark:bg-neutral-950" data-fettler-app>
      <header class="flex gap-1 items-center shrink-0 pl-2 pr-2 h-10 border-b border-neutral-200/70 dark:border-neutral-800/70" data-fettler-bar>
        <div class="relative shrink-0">
          <button type="button" class="flex gap-2 items-center px-2 h-7 text-[13px] hover:bg-neutral-200/60 dark:hover:bg-neutral-800/70 rounded-md" aria-haspopup="dialog" :aria-expanded="switcherOpen() ? 'true' : 'false'" :title="'Open a project (' + MOD + '+O)'" @click="switcherOpen.set(!switcherOpen())" data-fettler-switch>
            <span :class="dotClass()" class="h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
            <span class="font-medium" data-fettler-target>{{ connecting() ? 'Connecting' : targetLabel() }}</span>
            @if(environmentLabel())
              <span :class="isProduction() ? 'font-medium text-[11px] text-red-600 dark:text-red-400' : 'text-[11px] text-neutral-400'" data-fettler-environment>{{ environmentLabel() }}</span>
            @endif
            <span class="inline-block h-3.5 w-3.5 text-neutral-400 i-hugeicons-arrow-down-01" aria-hidden="true"></span>
          </button>

          @if(switcherOpen())
            <div class="fixed inset-0 z-40" @click="closeSwitcher()" aria-hidden="true"></div>
            <div class="absolute left-0 top-9 z-50 w-80 bg-white dark:bg-neutral-900 border border-neutral-200 rounded-lg dark:border-neutral-700 fettler-float" role="dialog" aria-label="Open a project" data-fettler-switcher>
              <label class="flex gap-2 items-center px-3 h-10 border-b border-neutral-200/70 dark:border-neutral-800">
                <span class="inline-block shrink-0 h-4 w-4 text-neutral-400 i-hugeicons-folder-01" aria-hidden="true"></span>
                <input
                  type="text"
                  :value="projectPath()"
                  @input="projectPath.set($event.target.value)"
                  @keydown.enter="connectProject()"
                  placeholder="Path to a project, then Enter"
                  aria-label="Project path"
                  autocomplete="off"
                  spellcheck="false"
                  autofocus
                  class="flex-1 min-w-0 font-mono text-xs bg-transparent focus:outline-none"
                  data-fettler-path
                >
              </label>
              <ul class="py-1 text-[13px]">
                <li><button type="button" class="flex gap-2.5 items-center px-3 h-8 w-full text-left hover:bg-neutral-100 dark:hover:bg-neutral-800" @click="openSandbox()" data-fettler-sandbox><span class="inline-block h-4 w-4 text-neutral-400 i-hugeicons-cube" aria-hidden="true"></span>Sandbox<span class="ml-auto text-[11px] text-neutral-400">no project</span></button></li>
                @foreach(recentProjects() as item)
                  <li><button type="button" class="flex gap-2.5 items-center px-3 h-8 w-full text-left hover:bg-neutral-100 dark:hover:bg-neutral-800" @click="openRecent(item)"><span :class="item.kind === 'local' ? 'i-hugeicons-folder-01' : 'i-hugeicons-cloud-server'" class="inline-block shrink-0 h-4 w-4 text-neutral-400" aria-hidden="true"></span><span class="shrink-0">{{ item.label }}</span><span class="ml-auto min-w-0 font-mono text-[11px] text-neutral-400 truncate">{{ item.path || item.where || '' }}</span></button></li>
                @endforeach
              </ul>
              <div class="py-1 text-[13px] border-neutral-200/70 border-t dark:border-neutral-800">
                <button type="button" class="flex gap-2.5 items-center px-3 h-8 w-full text-left hover:bg-neutral-100 dark:hover:bg-neutral-800" @click="openRemote()" data-fettler-remote><span class="inline-block h-4 w-4 text-neutral-400 i-hugeicons-server-stack-01" aria-hidden="true"></span>Server, container or pod</button>
              </div>
            </div>
          @endif
        </div>

        <div class="flex overflow-x-auto flex-1 gap-0.5 items-center px-1 min-w-0" role="tablist" aria-label="Buffers" data-fettler-tabs>
          @foreach(tabs() as tab)
            <span :class="tab.id === activeTab() ? 'flex items-center shrink-0 pl-2.5 pr-1 h-7 text-[12px] text-neutral-900 dark:text-neutral-100 bg-neutral-200/70 dark:bg-neutral-800 rounded-md' : 'flex items-center shrink-0 px-2.5 h-7 text-[12px] text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 rounded-md'">
              <button type="button" role="tab" :aria-selected="tab.id === activeTab() ? 'true' : 'false'" class="max-w-[14rem] font-mono truncate" @click="selectTab(tab.id)">{{ tab.id === activeTab() ? tabTitle({ code: code() }) : tabTitle(tab) }}</button>
              @if(tab.id === activeTab() && tabs().length > 1)
                <button type="button" class="flex items-center justify-center ml-1 h-5 w-5 text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 rounded" :aria-label="'Close ' + tabTitle(tab)" @click="closeTab(tab.id)"><span class="inline-block h-3 w-3 i-hugeicons-cancel-01" aria-hidden="true"></span></button>
              @endif
            </span>
          @endforeach
          <button type="button" class="flex items-center justify-center shrink-0 h-7 w-7 text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-200/60 dark:hover:bg-neutral-800/70 rounded-md" aria-label="New buffer" :title="'New buffer (' + MOD + '+T)'" @click="newTab()" data-fettler-new-tab><span class="inline-block h-3.5 w-3.5 i-hugeicons-add-01" aria-hidden="true"></span></button>
        </div>

        <button type="button" class="flex items-center shrink-0 px-2 h-7 font-mono text-[11px] text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-200/60 dark:hover:bg-neutral-800/70 rounded-md" aria-label="Open the command palette" :title="'Everything else (' + MOD + '+K)'" @click="openPalette()" data-fettler-palette-button>{{ MOD_KEY }}K</button>
        <button type="button" :class="paneOpen() ? 'text-neutral-900 dark:text-neutral-100 bg-neutral-200/70 dark:bg-neutral-800' : ''" class="flex items-center justify-center shrink-0 h-7 w-7 text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-200/60 dark:hover:bg-neutral-800/70 rounded-md" :aria-pressed="paneOpen() ? 'true' : 'false'" aria-label="Show or hide the side pane" :title="'Side pane (' + MOD + '+J)'" @click="togglePane()" data-fettler-pane-toggle><span class="inline-block h-4 w-4 i-hugeicons-sidebar-right" aria-hidden="true"></span></button>
        <button type="button" class="flex gap-1.5 items-center shrink-0 ml-1 pl-2.5 pr-2 h-7 font-medium text-[12px] text-white dark:text-neutral-900 bg-neutral-900 dark:bg-neutral-100 rounded-md disabled:opacity-40 transition-transform active:scale-[0.98]" :disabled="running() || !connected()" @click="runAll()" data-fettler-run>{{ running() ? 'Running' : 'Run' }}<span class="font-mono font-normal text-[10px] opacity-60">{{ RUN_KEYS }}</span></button>
      </header>

      @if(notice())
        <p class="flex gap-2 items-center px-3 py-1.5 text-[12px] text-neutral-600 dark:text-neutral-300 border-b border-neutral-200/70 dark:border-neutral-800/70" role="status" data-fettler-notice><span class="shrink-0 h-1.5 w-1.5 bg-amber-500 rounded-full" aria-hidden="true"></span><span class="flex-1 min-w-0">{{ notice() }}</span><button type="button" class="shrink-0 text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100" aria-label="Dismiss" @click="notice.set('')"><span class="inline-block h-3 w-3 i-hugeicons-cancel-01" aria-hidden="true"></span></button></p>
      @endif

      @if(confirming())
        <div class="flex gap-3 items-center px-3 py-2 text-red-900 text-xs dark:text-red-100 bg-red-50 dark:bg-red-500/15 border-b border-red-200 dark:border-red-500/30" role="alert" data-fettler-confirm>
          <span class="flex-1">This will run on <strong>{{ environmentLabel() }}</strong> at {{ whereLabel() || targetLabel() }}. Anything it writes is written for real.</span>
          <button type="button" class="px-2.5 h-6 text-xs bg-white dark:bg-neutral-900 border border-red-300 rounded dark:border-red-500/40" @click="confirming.set('')">Cancel</button>
          <button type="button" class="px-2.5 h-6 font-medium text-white text-xs bg-red-600 rounded" @click="guarded(confirming())" data-fettler-confirm-run>Run on {{ environmentLabel() }}</button>
        </div>
      @endif

      <main class="flex flex-1 min-h-0">
        <section class="flex-1 min-h-0 min-w-0" aria-label="Code" :style="editorStyle()" data-fettler-editor>
          <CodeEditor
            language="typescript"
            height="100%"
            :theme="editorTheme()"
            label="Code to run"
            v-model:value="code"
            @ref="editorRef"
            :diagnostics="diagnostics()"
            :widgets="widgets()"
            :autoComplete="true"
            :ghostText="ghost()"
            @selection="onSelection($event)"
            @input="scheduleCheck(); scheduleSuggest(); scheduleSave()"
            @complete="complete($event)"
            @run="runAll($event)"
            @run-selection="runSelection($event)"
          />
        </section>

        <aside :class="paneOpen() ? 'flex flex-col shrink-0 min-h-0 border-l border-neutral-200/70 dark:border-neutral-800/70 fettler-pane' : 'hidden'" aria-label="Result, log, assistant and connection" data-fettler-pane>
          <div class="flex gap-0.5 items-center shrink-0 px-2 h-9 border-b border-neutral-200/70 dark:border-neutral-800/70" role="tablist">
            @foreach(PANE_VIEWS as item)
              <button type="button" role="tab" :aria-selected="view() === item.id ? 'true' : 'false'" :class="view() === item.id ? 'px-2 h-6 text-[12px] font-medium text-neutral-900 dark:text-neutral-100' : 'px-2 h-6 text-[12px] text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200'" @click="showView(item.id)" :data-fettler-view="item.id">{{ item.title }}</button>
            @endforeach
            @if(view() === 'result' && duration())
              <span class="ml-auto pr-1 font-mono text-[11px] text-neutral-400">{{ duration() }}</span>
            @endif
            @if(view() === 'logs')
              <select :value="logLevel()" @change="logLevel.set($event.target.value)" aria-label="Lowest level to show" class="ml-auto px-1 h-6 text-[11px] text-neutral-500 bg-transparent rounded focus:outline-none">
                <option value="all">All levels</option>
                <option value="info">Info and up</option>
                <option value="warning">Warnings and errors</option>
                <option value="error">Errors</option>
              </select>
              <input type="text" :value="logQuery()" @input="logQuery.set($event.target.value)" placeholder="Filter" aria-label="Filter log lines" class="px-2 h-6 w-28 text-[11px] bg-neutral-100 dark:bg-neutral-900 rounded focus:outline-none">
              <span :class="logFollowing() ? 'bg-emerald-500' : 'bg-neutral-300 dark:bg-neutral-600'" class="h-1.5 w-1.5 rounded-full" :title="logFollowing() ? 'Following' : 'Stopped'" data-fettler-log-state></span>
            @endif
          </div>

          @if(view() === 'logs')
            <div class="overflow-y-auto flex-1 p-2 min-h-0 font-mono leading-5 text-[11px]" data-fettler-logs>
              @if(logNote())
                <p class="px-1 text-red-700 dark:text-red-300" role="alert">{{ logNote() }}</p>
              @endif
              @foreach(shownLogs() as line)
                <div :class="logClass(line.level)" class="flex gap-2 px-1"><span class="shrink-0 text-neutral-400">{{ line.time ? line.time.slice(11, 19) : '' }}</span><span class="shrink-0 w-12 uppercase">{{ line.level }}</span><span class="min-w-0 break-words whitespace-pre-wrap">{{ line.message }}</span></div>
              @endforeach
              @if(!logNote() && shownLogs().length === 0)
                <p class="px-1 text-neutral-500">{{ connected() ? 'No lines yet.' : 'Open a project to follow its log.' }}</p>
              @endif
            </div>
          @endif

          @if(view() === 'info')
            <div class="overflow-y-auto flex-1 p-3 space-y-3 min-h-0" data-fettler-info>
              @if(!connected())
                <p class="text-neutral-500 text-sm">Open a project to see what it is running on.</p>
              @endif
              @if(panelsNote())
                <p class="text-red-700 text-xs dark:text-red-300" role="alert">{{ panelsNote() }}</p>
              @endif
              @foreach(panels() as panel)
                <article class="bg-white dark:bg-neutral-900 border border-neutral-200 rounded-lg dark:border-neutral-800">
                  <h2 class="px-3 py-1.5 font-medium text-xs border-b border-neutral-200 dark:border-neutral-800">{{ panel.title }}</h2>
                  @foreach(panel.sections as section)
                    @if(section.title)
                      <h3 class="pt-2 px-3 text-[10px] text-neutral-400 tracking-wide uppercase">{{ section.title }}</h3>
                    @endif
                    <dl class="px-3 py-1.5">
                      @foreach(section.rows as row)
                        <div class="flex gap-3 py-0.5 text-xs"><dt class="shrink-0 w-32 text-neutral-500">{{ row[0] }}</dt><dd class="min-w-0 break-words font-mono">{{ row[1] }}</dd></div>
                      @endforeach
                    </dl>
                  @endforeach
                </article>
              @endforeach
            </div>
          @endif

          @if(view() === 'assistant')
            <div class="flex flex-1 flex-col min-h-0" data-fettler-assistant>
              <div class="overflow-y-auto flex-1 p-3 space-y-3 min-h-0">
                @if(!ai().enabled || !ai().hasKey)
                  <div class="p-3 text-neutral-600 text-sm dark:text-neutral-300 bg-white dark:bg-neutral-900 border border-neutral-200 rounded-lg dark:border-neutral-800">
                    <p>The assistant uses your own API key. It is kept in this computer's keychain. Only your code, your question and the names of your models and columns are sent, never rows of data.</p>
                    <button type="button" class="mt-3 px-3 h-7 font-medium text-white text-xs dark:text-neutral-900 bg-neutral-900 dark:bg-neutral-100 rounded-md" @click="aiOpen.set(true)">Set up AI</button>
                  </div>
                @endif
                @foreach(chat() as message)
                  <div :class="message.role === 'user' ? 'ml-8 p-2.5 text-sm bg-neutral-200 dark:bg-neutral-800 rounded-lg' : 'mr-8 p-2.5 text-sm bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-lg'">
                    <pre class="break-words font-sans whitespace-pre-wrap">{{ message.content }}</pre>
                    @if(message.code)
                      <button type="button" class="mt-2 px-2.5 h-6 text-xs border border-neutral-300 rounded dark:border-neutral-700" @click="useCode(message.code)">Put this code in the editor</button>
                    @endif
                  </div>
                @endforeach
                @if(asking())
                  <p class="text-neutral-500 text-xs">Thinking</p>
                @endif
                @if(chatNote())
                  <p class="text-red-700 text-xs dark:text-red-300" role="alert">{{ chatNote() }}</p>
                @endif
              </div>
              <div class="flex gap-2 p-2 border-neutral-200 border-t dark:border-neutral-800">
                <input type="text" :value="question()" @input="question.set($event.target.value)" @keydown.enter="ask()" placeholder="Describe what you want the code to do" aria-label="Question for the assistant" class="flex-1 px-2.5 h-8 text-sm bg-white dark:bg-neutral-900 border border-neutral-200 rounded-md dark:border-neutral-800 focus:border-neutral-400 focus:outline-none">
                <button type="button" class="px-3 h-8 font-medium text-white text-xs dark:text-neutral-900 bg-neutral-900 dark:bg-neutral-100 rounded-md disabled:opacity-40" :disabled="asking()" @click="ask()">Ask</button>
              </div>
            </div>
          @endif

          <div :class="view() === 'result' ? 'flex flex-col flex-1 min-h-0 overflow-y-auto' : 'hidden'" aria-live="polite">
          @if(!running() && !output() && !result() && !failure() && !queries().length)
            <p class="m-auto px-6 text-[13px] text-center text-neutral-400">Run with <span class="font-mono">{{ RUN_KEYS }}</span> to see the result here.</p>
          @endif

          @if(output())
            <article class="border-b border-neutral-200/70 dark:border-neutral-800/70" data-fettler-output>
              <h2 class="pt-2.5 px-3 text-[10px] text-neutral-400 tracking-wide uppercase">Output</h2>
              <pre class="overflow-x-auto p-3 font-mono text-xs whitespace-pre-wrap">{{ output() }}</pre>
            </article>
          @endif

          @if(result())
            <article class="border-b border-neutral-200/70 dark:border-neutral-800/70" data-fettler-result>
              <h2 class="flex gap-1 items-center pt-2 px-3 text-[11px] text-neutral-500">
                @if(inspectable())
                  <button type="button" :class="resultView() === 'tree' ? VIEW_ON : VIEW_OFF" @click="resultView.set('tree')" data-fettler-view-tree>Inspect</button>
                @endif
                @if(grid())
                  <button type="button" :class="resultView() === 'table' ? VIEW_ON : VIEW_OFF" @click="resultView.set('table')" data-fettler-view-table>Table</button>
                @endif
                @if(resultModels().length)
                  <button type="button" :class="resultView() === 'graph' ? VIEW_ON : VIEW_OFF" @click="showGraph()" data-fettler-view-graph>Relations</button>
                @endif
                @if(previewMarkup())
                  <button type="button" :class="resultView() === 'preview' ? VIEW_ON : VIEW_OFF" @click="resultView.set('preview')" data-fettler-view-preview>Preview</button>
                @endif
                <button type="button" :class="resultView() === 'text' ? VIEW_ON : VIEW_OFF" @click="resultView.set('text')" data-fettler-view-text>Text</button>
              </h2>

              @if(resultView() === 'tree' && inspectable())
                <div data-fettler-tree>
                  <JsonTree label="Result" height="calc(100vh - 9.5rem)" depth="2" :tinker="lastValue()" @open="openNode($event)" />
                </div>
              @endif

              @if(resultView() === 'table' && grid())
                <div data-fettler-table>
                  <DataGrid label="Result rows" fileName="fettler-result" height="calc(100vh - 9.5rem)" :rows="grid().rows" :columns="grid().columns" />
                  @if(grid().more)
                    <p class="px-3 py-1.5 text-[11px] text-neutral-400 border-neutral-200 border-t dark:border-neutral-800">{{ grid().more }} more rows were not sent.</p>
                  @endif
                </div>
              @endif

              @if(resultView() === 'graph' && resultModels().length)
                <div data-fettler-graph>
                  @if(relations().nodes.length)
                    <GraphView id="fettler-relations" label="Model relations" height="calc(100vh - 9.5rem)" :nodes="relations().nodes" :edges="relations().edges" @expand="expandRelations($event)" />
                  @else
                    <p class="p-3 text-neutral-500 text-xs dark:text-neutral-400">{{ modelList() ? 'This session lists no relations for that model.' : 'Reading the models...' }}</p>
                  @endif
                </div>
              @endif

              @if(resultView() === 'preview' && previewMarkup())
                <div data-fettler-preview>
                  <PreviewFrame title="Rendered preview" height="calc(100vh - 9.5rem)" :html="previewMarkup()" />
                </div>
              @endif

              @if(resultView() === 'text' || (resultView() === 'tree' && !inspectable()) || (resultView() === 'table' && !grid()) || (resultView() === 'graph' && !resultModels().length) || (resultView() === 'preview' && !previewMarkup()))
                <pre class="overflow-x-auto p-3 font-mono text-xs whitespace-pre-wrap">{{ result() }}</pre>
              @endif
            </article>
          @endif

          @if(failure())
            <article class="bg-red-50/60 dark:bg-red-500/10 border-b border-red-200/70 dark:border-red-500/20" data-fettler-error>
              <h2 class="pt-2.5 px-3 text-[10px] text-red-600 tracking-wide uppercase dark:text-red-400">Error</h2>
              <pre class="overflow-x-auto p-3 font-mono text-red-800 text-xs whitespace-pre-wrap dark:text-red-200">{{ failure() }}</pre>
            </article>
          @endif

          @if(queries().length)
            <article class="border-b border-neutral-200/70 dark:border-neutral-800/70" data-fettler-queries>
              <h2 class="pt-2.5 px-3 text-[10px] text-neutral-400 tracking-wide uppercase">Queries ({{ queries().length }})</h2>
              <ul class="divide-neutral-200 divide-y dark:divide-neutral-800">
                @foreach(queries() as query)
                  <li class="flex gap-3 px-3 py-1.5 font-mono text-xs"><span class="shrink-0 text-neutral-400">{{ query.durationMs }} ms</span><span class="min-w-0 break-words">{{ query.sql }}</span></li>
                @endforeach
              </ul>
            </article>
          @endif
          </div>
        </aside>
      </main>

      <footer class="flex gap-4 items-center shrink-0 px-3 h-6 text-[11px] text-neutral-400 border-neutral-200/70 border-t dark:border-neutral-800/70" data-fettler-status>
        <span class="min-w-0 font-mono truncate" data-fettler-where>{{ whereLabel() }}</span>
        <span class="shrink-0 ml-auto" :class="problems() ? 'text-red-600 dark:text-red-400' : ''" data-fettler-problems>{{ problems() === 0 ? 'No problems' : problems() === 1 ? '1 problem' : problems() + ' problems' }}</span>
        <span class="shrink-0 font-mono">{{ caretLabel() }}</span>
        <span class="shrink-0">TypeScript</span>
      </footer>

      @if(licenseOpen())
        <div class="flex fixed inset-0 z-40 items-start justify-center pt-20 bg-black/30" @click.self="licenseOpen.set(false)" data-fettler-license>
          <div class="max-w-md w-full bg-white dark:bg-neutral-900 border border-neutral-200 rounded-xl dark:border-neutral-700 fettler-float" role="dialog" aria-modal="true" aria-label="License">
            <div class="grid gap-3 p-4">
              <p class="text-sm" data-fettler-license-summary>{{ licenseSummary() }}</p>
              <p class="text-[11px] text-neutral-500">Fettler {{ license().version }}, built {{ license().buildDate }}. A license covers two devices. Local projects and the sandbox are free.</p>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">License key
                <input type="text" :value="licenseKey()" @input="licenseKey.set($event.target.value)" @keydown.enter="activateLicense()" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 rounded-md dark:border-neutral-700 focus:outline-none">
              </label>
              @if(licenseNote())
                <p class="text-neutral-700 text-xs dark:text-neutral-200" role="status">{{ licenseNote() }}</p>
              @endif
              @if(licenseDevices().length)
                <ul class="text-xs border border-neutral-200 divide-neutral-200 divide-y rounded-md dark:border-neutral-700 dark:divide-neutral-800">
                  @foreach(licenseDevices() as device)
                    <li class="flex gap-3 px-3 py-1.5"><span>{{ device.name || 'A device' }}</span><span class="ml-auto text-neutral-400">{{ device.platform || '' }}</span></li>
                  @endforeach
                </ul>
              @endif
            </div>
            <div class="flex gap-2 justify-end px-4 py-3 border-neutral-200 border-t dark:border-neutral-800">
              @if(license().standing && license().standing.licensed)
                <button type="button" class="mr-auto px-3 h-8 text-xs border border-neutral-200 rounded-md dark:border-neutral-700" @click="releaseLicense()">Stop using it on this device</button>
              @endif
              <button type="button" class="px-3 h-8 text-xs border border-neutral-200 rounded-md dark:border-neutral-700" @click="licenseOpen.set(false)">Close</button>
              <button type="button" class="px-3 h-8 font-medium text-white text-xs dark:text-neutral-900 bg-neutral-900 dark:bg-neutral-100 rounded-md disabled:opacity-50" :disabled="licenseBusy()" @click="activateLicense()">Activate</button>
            </div>
          </div>
        </div>
      @endif

      @if(mcpOpen())
        <div class="flex fixed inset-0 z-40 items-start justify-center pt-20 bg-black/30" @click.self="mcpOpen.set(false)" data-fettler-mcp>
          <div class="max-w-lg w-full bg-white dark:bg-neutral-900 border border-neutral-200 rounded-xl dark:border-neutral-700 fettler-float" role="dialog" aria-modal="true" aria-label="MCP settings">
            <div class="grid gap-3 p-4">
              <p class="text-sm">Let an AI tool such as Claude or Cursor run code through Fettler, in the connections you have opened. It works while Fettler is open.</p>
              <p class="text-[11px] text-neutral-500">A production connection is refused unless the tool is told to confirm it. Turning this on makes a new token and ends the old one.</p>
              @if(mcp().enabled)
                <pre class="overflow-x-auto p-3 font-mono text-[11px] bg-neutral-100 dark:bg-neutral-950 border border-neutral-200 rounded-md dark:border-neutral-800" data-fettler-mcp-config>{{ mcpConfig() }}</pre>
                @if(!mcp().token)
                  <p class="text-[11px] text-neutral-500">The token was shown once when this was turned on. Turn it off and on again for a new one.</p>
                @endif
              @endif
            </div>
            <div class="flex gap-2 justify-end px-4 py-3 border-neutral-200 border-t dark:border-neutral-800">
              <button type="button" class="px-3 h-8 text-xs border border-neutral-200 rounded-md dark:border-neutral-700" @click="mcpOpen.set(false)">Close</button>
              @if(mcp().enabled)
                <button type="button" class="px-3 h-8 text-xs border border-neutral-200 rounded-md dark:border-neutral-700" @click="setMcp(false)">Turn off</button>
              @endif
              @if(!mcp().enabled)
                <button type="button" class="px-3 h-8 font-medium text-white text-xs dark:text-neutral-900 bg-neutral-900 dark:bg-neutral-100 rounded-md" @click="setMcp(true)">Turn on</button>
              @endif
            </div>
          </div>
        </div>
      @endif

      @if(aiOpen())
        <div class="flex fixed inset-0 z-40 items-start justify-center pt-20 bg-black/30" @click.self="aiOpen.set(false)" data-fettler-ai-settings>
          <div class="max-w-md w-full bg-white dark:bg-neutral-900 border border-neutral-200 rounded-xl dark:border-neutral-700 fettler-float" role="dialog" aria-modal="true" aria-label="AI settings">
            <div class="grid gap-3 p-4">
              <label class="flex gap-2 items-center text-sm"><input type="checkbox" :checked="ai().enabled" @change="setAi('enabled', $event.target.checked)"> Use AI in Fettler</label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Provider
                <select :value="ai().provider" @change="setAi('provider', $event.target.value)" class="px-2 h-8 text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 rounded-md dark:border-neutral-700">
                  <option value="anthropic">Anthropic</option>
                  <option value="openai">OpenAI</option>
                  <option value="ollama">Ollama (runs on this computer)</option>
                </select>
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Model (optional)
                <input type="text" :value="ai().model" @input="setAi('model', $event.target.value)" placeholder="The provider's fast model" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 rounded-md dark:border-neutral-700 focus:outline-none">
              </label>
              @if(ai().provider === 'ollama')
                <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Ollama address
                  <input type="text" :value="ai().host" @input="setAi('host', $event.target.value)" placeholder="http://127.0.0.1:11434" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 rounded-md dark:border-neutral-700 focus:outline-none">
                </label>
              @endif
              @if(ai().provider !== 'ollama')
                <label class="flex flex-col gap-1 text-[11px] text-neutral-500">{{ ai().hasKey ? 'API key (one is saved; type to replace it)' : 'API key' }}
                  <input type="password" :value="aiKey()" @input="aiKey.set($event.target.value)" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 rounded-md dark:border-neutral-700 focus:outline-none">
                </label>
              @endif
              <label class="flex gap-2 items-center text-sm"><input type="checkbox" :checked="ai().automatic" @change="setAi('automatic', $event.target.checked)"> Suggest after a pause, not only on Alt+Backslash</label>
              <p class="text-[11px] text-neutral-500">The key is stored in this computer's keychain and is never shown again. Requests carry your code, your question and the names of your models and columns.</p>
            </div>
            <div class="flex gap-2 justify-end px-4 py-3 border-neutral-200 border-t dark:border-neutral-800">
              @if(ai().hasKey && ai().provider !== 'ollama')
                <button type="button" class="mr-auto px-3 h-8 text-red-700 text-xs dark:text-red-300 border border-neutral-200 rounded-md dark:border-neutral-700" @click="forgetKey()">Forget the key</button>
              @endif
              <button type="button" class="px-3 h-8 text-xs border border-neutral-200 rounded-md dark:border-neutral-700" @click="aiOpen.set(false)">Cancel</button>
              <button type="button" class="px-3 h-8 font-medium text-white text-xs dark:text-neutral-900 bg-neutral-900 dark:bg-neutral-100 rounded-md disabled:opacity-50" :disabled="aiSaving()" @click="saveAi()">Save</button>
            </div>
          </div>
        </div>
      @endif

      @if(connectOpen())
        <div class="flex fixed inset-0 z-40 items-start justify-center pt-16 bg-black/30" @click.self="connectOpen.set(false)" data-fettler-connect>
          <div class="max-w-lg w-full bg-white dark:bg-neutral-900 border border-neutral-200 rounded-xl dark:border-neutral-700 fettler-float" role="dialog" aria-modal="true" aria-label="Connect to a remote target">
            <div class="flex gap-1 p-2 border-b border-neutral-200 dark:border-neutral-800" role="tablist">
              <button type="button" role="tab" :aria-selected="connectKind() === 'ssh' ? 'true' : 'false'" :class="connectKind() === 'ssh' ? 'px-3 h-7 text-xs font-medium bg-neutral-100 dark:bg-neutral-800 rounded-md' : 'px-3 h-7 text-xs text-neutral-500 rounded-md'" @click="connectKind.set('ssh'); found.set([])">SSH</button>
              <button type="button" role="tab" :aria-selected="connectKind() === 'docker' ? 'true' : 'false'" :class="connectKind() === 'docker' ? 'px-3 h-7 text-xs font-medium bg-neutral-100 dark:bg-neutral-800 rounded-md' : 'px-3 h-7 text-xs text-neutral-500 rounded-md'" @click="connectKind.set('docker'); found.set([])">Docker</button>
              <button type="button" role="tab" :aria-selected="connectKind() === 'kube' ? 'true' : 'false'" :class="connectKind() === 'kube' ? 'px-3 h-7 text-xs font-medium bg-neutral-100 dark:bg-neutral-800 rounded-md' : 'px-3 h-7 text-xs text-neutral-500 rounded-md'" @click="connectKind.set('kube'); found.set([])">Kubernetes</button>
            </div>
            <div class="pt-3 px-4" data-fettler-boxes>
              <div class="flex gap-2 items-center">
                <button type="button" class="px-2.5 h-7 text-xs border border-neutral-200 rounded-md dark:border-neutral-700 disabled:opacity-50" :disabled="boxesLoading()" @click="loadBoxes()">{{ boxesLoading() ? 'Asking the project' : 'Servers this project is deployed to' }}</button>
                <span class="min-w-0 text-[11px] text-neutral-500 truncate">{{ boxesNote() }}</span>
              </div>
              @if(boxes().length)
                <ul class="mt-2 border border-neutral-200 divide-neutral-200 divide-y rounded-md dark:border-neutral-700 dark:divide-neutral-800">
                  @foreach(boxes() as box)
                    <li class="flex gap-3 items-baseline px-3 py-1.5 text-xs hover:bg-neutral-100 dark:hover:bg-neutral-800 cursor-default" @click="connectBox(box)"><span class="font-medium">{{ box.title }}</span><span class="ml-auto min-w-0 font-mono text-[11px] text-neutral-400 truncate">{{ box.connection.directory }}</span></li>
                  @endforeach
                </ul>
              @endif
            </div>
            <div class="grid gap-3 grid-cols-2 p-4">
              @if(connectKind() === 'ssh')
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Host
                <input type="text" :value="form().host" @input="setField('host', $event.target.value)" placeholder="box.example.com" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 rounded-md dark:border-neutral-700 focus:border-neutral-400 focus:outline-none">
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">User
                <input type="text" :value="form().user" @input="setField('user', $event.target.value)" placeholder="root" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 rounded-md dark:border-neutral-700 focus:border-neutral-400 focus:outline-none">
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Port
                <input type="text" :value="form().port" @input="setField('port', $event.target.value)" placeholder="22" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 rounded-md dark:border-neutral-700 focus:border-neutral-400 focus:outline-none">
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Jump host (optional)
                <input type="text" :value="form().jump" @input="setField('jump', $event.target.value)" placeholder="me@bastion" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 rounded-md dark:border-neutral-700 focus:border-neutral-400 focus:outline-none">
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500" style="grid-column: span 2">Identity file (optional)
                <input type="text" :value="form().identityFile" @input="setField('identityFile', $event.target.value)" placeholder="/Users/me/.ssh/id_ed25519" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 rounded-md dark:border-neutral-700 focus:border-neutral-400 focus:outline-none">
              </label>
              @endif
              @if(connectKind() === 'kube')
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Context (optional)
                <input type="text" :value="form().context" @input="setField('context', $event.target.value)" placeholder="current context" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 rounded-md dark:border-neutral-700 focus:border-neutral-400 focus:outline-none">
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Namespace
                <input type="text" :value="form().namespace" @input="setField('namespace', $event.target.value)" placeholder="default" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 rounded-md dark:border-neutral-700 focus:border-neutral-400 focus:outline-none">
              </label>
              @endif
              @if(connectKind() !== 'docker')
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Pod
                <input type="text" :value="form().pod" @input="setField('pod', $event.target.value)" placeholder="api-0" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 rounded-md dark:border-neutral-700 focus:border-neutral-400 focus:outline-none">
              </label>
              @endif
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Container
                <input type="text" :value="form().container" @input="setField('container', $event.target.value)" placeholder="web-1" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 rounded-md dark:border-neutral-700 focus:border-neutral-400 focus:outline-none">
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500" style="grid-column: span 2">Project directory on the target
                <input type="text" :value="form().directory" @input="setField('directory', $event.target.value)" placeholder="/var/www/app/current" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 rounded-md dark:border-neutral-700 focus:border-neutral-400 focus:outline-none">
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-neutral-500">Env file to export (optional)
                <input type="text" :value="form().envFile" @input="setField('envFile', $event.target.value)" placeholder=".env" autocomplete="off" spellcheck="false" class="px-2 h-8 font-mono text-neutral-900 text-xs dark:text-neutral-100 bg-white dark:bg-neutral-950 border border-neutral-200 rounded-md dark:border-neutral-700 focus:border-neutral-400 focus:outline-none">
              </label>
              <div class="flex flex-wrap gap-2 items-end">
                <button type="button" class="px-2.5 h-8 text-xs border border-neutral-200 rounded-md dark:border-neutral-700 disabled:opacity-50" :disabled="finding()" @click="discover('containers')">List containers</button>
                <button type="button" class="px-2.5 h-8 text-xs border border-neutral-200 rounded-md dark:border-neutral-700 disabled:opacity-50" :disabled="finding()" @click="discover('pods')">List pods</button>
              </div>
            </div>
            @if(found().length)
              <ul class="overflow-y-auto mb-3 mx-4 max-h-40 border border-neutral-200 divide-neutral-200 divide-y rounded-md dark:border-neutral-700 dark:divide-neutral-800" data-fettler-found>
                @foreach(found() as item)
                  <li class="flex gap-3 px-3 py-1.5 font-mono text-xs hover:bg-neutral-100 dark:hover:bg-neutral-800 cursor-default" @click="pick(item)"><span>{{ item.value }}</span><span class="ml-auto text-neutral-400 truncate">{{ item.hint }}</span></li>
                @endforeach
              </ul>
            @endif
            <p class="pb-3 px-4 text-[11px] text-neutral-500">Keys come from your SSH agent. Fettler never asks for a password and writes nothing on the target.</p>
            <div class="flex gap-2 justify-end px-4 py-3 border-neutral-200 border-t dark:border-neutral-800">
              <button type="button" class="px-3 h-8 text-xs border border-neutral-200 rounded-md dark:border-neutral-700" @click="connectOpen.set(false)">Cancel</button>
              <button type="button" class="px-3 h-8 font-medium text-white text-xs dark:text-neutral-900 bg-neutral-900 dark:bg-neutral-100 rounded-md disabled:opacity-50" :disabled="connecting()" @click="connectRemote()" data-fettler-connect-go>{{ connecting() ? 'Connecting' : 'Connect' }}</button>
            </div>
          </div>
        </div>
      @endif

      @if(paletteOpen())
        <div class="flex fixed inset-0 z-40 items-start justify-center pt-24 bg-black/30" @click.self="closePalette()" data-fettler-palette>
          <div class="overflow-hidden max-w-xl w-full bg-white dark:bg-neutral-900 border border-neutral-200 rounded-xl dark:border-neutral-700 fettler-float" role="dialog" aria-modal="true" aria-label="Command palette">
            <input
              ref="paletteInput"
              type="text"
              role="combobox"
              aria-expanded="true"
              aria-controls="fettler-palette-list"
              aria-label="Search commands, projects, snippets and history"
              placeholder="Search commands, projects, snippets and history"
              :value="paletteQuery()"
              @input="paletteQuery.set($event.target.value); paletteActive.set(0)"
              @keydown="paletteKey($event)"
              class="px-4 h-12 w-full text-sm bg-transparent border-b border-neutral-200 dark:border-neutral-800 focus:outline-none"
            >
            <ul id="fettler-palette-list" role="listbox" class="overflow-y-auto py-1 max-h-96">
              @foreach(paletteItems() as item, index)
                <li
                  role="option"
                  :aria-selected="index === paletteActive() ? 'true' : 'false'"
                  :class="index === paletteActive() ? 'flex gap-3 items-baseline px-4 py-2 cursor-default bg-neutral-100 dark:bg-neutral-800' : 'flex gap-3 items-baseline px-4 py-2 cursor-default'"
                  @click="choose(item)"
                  @mousemove="paletteActive.set(index)"
                >
                  @if(item.kind !== 'action')
                    <span :class="PALETTE_ICONS[item.kind] || 'i-hugeicons-folder-01'" class="inline-block self-center shrink-0 h-4 w-4 text-neutral-400" aria-hidden="true"></span>
                  @endif
                  <span :class="item.kind === 'snippet' || item.kind === 'history' ? 'min-w-0 font-mono text-xs truncate' : 'min-w-0 text-[13px] truncate'">{{ item.title }}</span>
                  <span class="ml-auto min-w-0 text-[11px] text-neutral-400 truncate">{{ item.hint }}</span>
                </li>
              @endforeach
              @if(paletteItems().length === 0)
                <li class="px-4 py-3 text-neutral-500 text-sm">Nothing matches.</li>
              @endif
            </ul>
          </div>
        </div>
      @endif
    </div>
    </div>
  </body>
</html>
