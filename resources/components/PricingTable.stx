<script server>
import { CHECKOUT_OPEN, formatCents, PLANS, PRO_UNLOCKS } from '~/app/Billing/plans'

// Free on one side, Pro on the other. Pro is one product sold two ways, so
// what it unlocks is listed once and the two prices sit under it.
const free = PLANS.find(plan => plan.id === 'free')!
const paid = PLANS.filter(plan => plan.pro).map(plan => ({
  ...plan,
  price: formatCents(plan.priceCents),
  // What this way of paying adds beyond the shared Pro list.
  own: plan.includes.filter(line => line !== 'Everything in Free' && !PRO_UNLOCKS.includes(line)),
  featured: plan.id === 'standard',
}))
const checkoutOpen = CHECKOUT_OPEN
</script>
<div class="grid gap-4 grid-cols-1 lg:grid-cols-[1fr_2fr]">
  <article class="flex flex-col p-6 md:p-8 border border-line rounded-xl reveal">
    <h2 class="font-semibold text-ink text-lg">{{ free.name }}</h2>
    <p class="flex gap-2 items-baseline mt-4">
      <span class="font-semibold text-5xl text-ink tracking-tight num">{{ formatCents(free.priceCents) }}</span>
      <span class="text-muted">{{ free.cadence }}</span>
    </p>
    <p class="mt-3 leading-relaxed text-muted">{{ free.blurb }}</p>
    <ul class="flex flex-col gap-3 mt-6">
      @foreach(free.includes as line)
        <li class="flex gap-3 items-start text-ink">
          <span class="shrink-0 mt-0.5 size-5 text-muted i-hugeicons-tick-02" aria-hidden="true"></span>
          <span>{{ line }}</span>
        </li>
      @endforeach
    </ul>
    <div class="grow"></div>
    <p class="mt-8 text-muted text-sm">{{ free.terms }}</p>
  </article>

  <article class="p-6 md:p-8 bg-surface border border-line rounded-xl pro-plan reveal">
    <h2 class="font-semibold text-ink text-lg">Pro</h2>
    <p class="mt-3 max-w-[52ch] leading-relaxed text-muted">Everything in Free, plus the work that happens off your own machine.</p>
    <ul class="grid gap-3 grid-cols-1 mt-6">
      @foreach(PRO_UNLOCKS as line)
        <li class="flex gap-3 items-start text-ink">
          <span class="shrink-0 mt-0.5 size-5 text-accent-ink i-hugeicons-tick-02" aria-hidden="true"></span>
          <span>{{ line }}</span>
        </li>
      @endforeach
    </ul>

    <div class="grid gap-4 grid-cols-1 md:grid-cols-2 mt-8">
      @foreach(paid as plan)
        <div class="flex flex-col p-5 md:p-6 bg-page border rounded-xl {{ plan.featured ? 'border-accent' : 'border-line' }}">
          <h3 class="font-medium text-ink">{{ plan.name }}</h3>
          <p class="flex gap-2 items-baseline mt-3">
            <span class="font-semibold text-5xl text-ink tracking-tight num">{{ plan.price }}</span>
            <span class="text-muted">{{ plan.cadence }}</span>
          </p>
          <ul class="flex flex-col gap-2 mt-4 text-ink">
            @foreach(plan.own as line)
              <li>{{ line }}</li>
            @endforeach
          </ul>
          <div class="grow"></div>
          @if(checkoutOpen)
            <a href="/checkout/{{ plan.id }}" class="mt-6 w-full btn {{ plan.featured ? 'btn-primary' : 'btn-ghost' }}">Buy {{ plan.name }}</a>
          @else
            <p class="mt-6 w-full btn btn-off">Not on sale yet</p>
          @endif
          <p class="mt-3 text-muted text-sm">{{ plan.terms }}</p>
        </div>
      @endforeach
    </div>
  </article>
</div>
